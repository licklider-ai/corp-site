---
import PageMenu from '../components/PageMenu.astro';
import SideMenu from '../components/SideMenu.astro';
import type { TocItem } from '../consts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  /** ページ内メニューに並べる見出し */
  toc: TocItem[];
  markdownHref?: string;
  llmsHref?: string;
}

const { title, description, toc, markdownHref, llmsHref } = Astro.props;
---

{/* 下層ページ: ヘッダーの下に 左から サイドメニュー / コンテンツ / ページ内メニュー */}
<BaseLayout
  title={title}
  description={description}
  markdownHref={markdownHref}
  llmsHref={llmsHref}
>
  <div class="shell">
    <div class="side">
      <SideMenu />
    </div>

    <div class="toc">
      <PageMenu items={toc} />
    </div>

    <article class="content">
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  .shell {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 3rem var(--gutter) 0;
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr) 11rem;
    grid-template-areas: 'side content toc';
    gap: 3rem;
    /* align-items は既定の stretch のまま。列が本文の高さまで伸びることで、
       中の sticky なメニューがスクロールに追従できる */
  }

  .side {
    grid-area: side;
  }

  .toc {
    grid-area: toc;
  }

  .content {
    grid-area: content;
    max-width: var(--measure);
  }

  @media (max-width: 1000px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'side'
        'toc'
        'content';
      gap: 2rem;
      padding-top: 2rem;
    }
  }
</style>
