---
import type { TocItem } from '../consts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  /** ページ内メニューに並べる見出し */
  toc: TocItem[];
  markdownHref?: string;
  llmsHref?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  markdownHref,
  llmsHref,
  ogType,
  publishedTime,
  modifiedTime,
  structuredData,
} = Astro.props;
---

{/* 下層ページはグローバルヘッダーと中央コンテンツに絞る。 */}
<BaseLayout
  title={title}
  description={description}
  markdownHref={markdownHref}
  llmsHref={llmsHref}
  ogType={ogType}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  structuredData={structuredData}
>
  <div class="shell">
    <article class="content">
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
@layer legacy {

  .shell {
    max-width: calc(62rem + var(--gutter) + var(--gutter));
    margin: 0 auto;
    padding: 3.5rem var(--gutter) 0;
  }

  .content {
    width: 100%;
    max-width: none;
    min-width: 0;
  }

  @media (max-width: 1000px) {
    .shell {
      padding-top: 2rem;
    }
  }

}
</style>
