---
import type { PublicationCategory } from '../data/publications';
import { PUBLICATIONS, publicationDate, publicationPublished, publicationModified, publicationModifiedInstant } from '../data/publications';
import type { TocItem } from '../consts';
import PageLayout from './PageLayout.astro';

interface Props {
  category: PublicationCategory;
  type: string;
  title: string;
  description: string;
  published: string;
  updated?: string;
  status: string;
  toc: TocItem[];
}

const { category, title, description, toc } = Astro.props;
const item = PUBLICATIONS.find((item) => item.href === Astro.url.pathname);
const published = item?.date ?? Astro.props.published;
const updated = item ? item.updated : Astro.props.updated;
const publishedTime = item ? publicationPublished(item) : publicationDate(published);
const modifiedTime = item ? publicationModified(item) : publicationDate(updated ?? published);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const structuredData = {
  '@type': 'Article',
  headline: title,
  description,
  datePublished: publishedTime,
  dateModified: modifiedTime,
  articleSection: category,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  author: { '@id': new URL('/#organization', Astro.site).href },
  publisher: { '@id': new URL('/#organization', Astro.site).href },
};
---

<PageLayout
  title={title}
  description={description}
  toc={toc}
  ogType="article"
  publishedTime={item?.publishedTime?.at}
  modifiedTime={item ? publicationModifiedInstant(item) : undefined}
  structuredData={structuredData}
>
  <div class="publication">
    <header class="page-head">
      <p class="publication-dates">
        <span>Published <time datetime={publishedTime}>{published}</time></span>
        {updated && (
          <>
            <span class="date-divider" aria-hidden="true">|</span>
            <span>Updated <time datetime={modifiedTime}>{updated}</time></span>
          </>
        )}
      </p>
      <h1>{title}</h1>
      <p class="standfirst">{description}</p>

    </header>

    {Astro.slots.has('thumbnail') && (
      <div class="publication-thumbnail">
        <slot name="thumbnail" />
      </div>
    )}

    <div class="body">
      <slot />
    </div>
  </div>
</PageLayout>

<style>
  .publication-dates {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    margin: 0;
    color: var(--ink-3);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .publication-dates > span {
    white-space: nowrap;
  }

  /* The article canvas stays wide; all reading content shares one centered measure. */
  .publication {
    --reading-width: 52rem;
    container-type: inline-size;
  }

  .page-head,
  .body {
    width: 100%;
    max-width: var(--reading-width);
    margin-inline: auto;
    overflow-wrap: anywhere;
  }

  .page-head .standfirst {
    max-width: none;
  }

  .publication-thumbnail {
    margin-block: 2.5rem 0;
  }

  /* Full-width media uses the article canvas, including on narrow screens.
     Use figures (with optional captions) directly in the body or a section. */
  .body > :global(figure),
  .body :global(section > figure),
  .body > :global(img),
  .body :global(section > img),
  .body > :global(picture),
  .body :global(section > picture),
  .body :global(p:has(> img:only-child)),
  .body :global(p:has(> picture:only-child)) {
    display: block;
    width: 100cqw;
    max-width: none;
    margin-inline: calc((100% - 100cqw) / 2);
    margin-block: 2rem;
  }

  .publication-thumbnail :global(figure) {
    margin: 0;
  }

  .publication-thumbnail :global(img),
  .body :global(figure img),
  .body :global(picture img),
  .body :global(p > img:only-child) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  .body > :global(img),
  .body :global(section > img) {
    display: block;
    height: auto;
  }

  .publication-thumbnail :global(figcaption),
  .body :global(figcaption) {
    max-width: var(--reading-width);
    margin: 0.75rem auto 0;
    color: var(--ink-2);
    font-size: 0.875rem;
  }

@layer legacy {

  .publication {
    width: 100%;
    padding-bottom: 1rem;
  }

  .page-head {
    padding-bottom: 2.75rem;
    border-bottom: 1px solid var(--rule);
  }

  h1 {
    margin: 1rem 0 1.35rem;
    font-size: clamp(2rem, 4.3vw, 3.15rem);
    line-height: 1.18;
    letter-spacing: -0.01em;
  }

  .standfirst {
    margin: 0;
    color: var(--ink-2);
    font-size: 1.1rem;
  }

  .body {
    max-width: 52rem;
    padding-top: 0.25rem;
  }

  .body :global(section) {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--rule-faint);
  }

  .body :global(section:last-child) {
    border-bottom: 0;
  }

  .body :global(h2) {
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }

  .body :global(h3) {
    margin: 1.75rem 0 0.75rem;
    font-size: 1.05rem;
  }

  .body :global(.notice) {
    padding: 1.25rem 1.4rem;
    background: var(--wash);
    border-left: 2px solid var(--ink-3);
  }

  .body :global(.notice > :last-child),
  .body :global(section > :last-child) {
    margin-bottom: 0;
  }

  .body :global(pre) {
    overflow-x: auto;
    padding: 1rem 1.15rem;
    background: var(--wash);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.86em;
  }


}
</style>
