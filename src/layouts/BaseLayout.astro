---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_META_TITLE, SITE_TITLE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  markdownHref?: string;
  llmsHref?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  markdownHref,
  llmsHref = '/llms.txt',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  structuredData,
} = Astro.props;
const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_META_TITLE;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const markdownUrl = markdownHref ? new URL(markdownHref, Astro.site) : undefined;
const llmsUrl = new URL(llmsHref, Astro.site);
const socialImageUrl = new URL('/og.png', Astro.site);
const rssUrl = new URL('/rss.xml', Astro.site);
const jsonFeedUrl = new URL('/feed.json', Astro.site);
const additionalStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', Astro.site).href,
      name: 'Licklider, Inc.',
      url: new URL('/', Astro.site).href,
      sameAs: ['https://github.com/licklider-ai'],
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      name: SITE_TITLE,
      url: new URL('/', Astro.site).href,
      description: SITE_DESCRIPTION,
      publisher: { '@id': new URL('/#organization', Astro.site).href },
    },
    ...additionalStructuredData,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Licklider, Inc." />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="describedby" href={llmsUrl} />
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    <link rel="alternate" type="application/rss+xml" title="Licklider — Latest" href={rssUrl} />
    <link rel="alternate" type="application/feed+json" title="Licklider — Latest" href={jsonFeedUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Licklider — The verification layer for AI research agents" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
    z-index: 10;
    background: var(--paper);
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--ink);
  }
</style>
