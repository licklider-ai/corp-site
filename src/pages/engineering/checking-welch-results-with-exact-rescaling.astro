<tr><td>1</td><td>−2.44949</td><td>4</td><td>0.070484</td><td>None</td></tr>
<tr><td>2^-300</td><td>−2.44949</td><td>1</td><td>0.246752</td><td>None</td></tr>
<tr><td>2^300</td><td>−2.44949</td><td>1</td><td>0.246752</td><td>Three overflow warnings</td></tr>
