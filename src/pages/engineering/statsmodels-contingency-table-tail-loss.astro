        <a href="https://github.com/statsmodels/statsmodels/commit/9f49dcd7281bd27747d0b6f988c07a13a4db747e">statsmodels merge commit 9f49dcd</a>
        — exact revision merged into <code>main</code>
      </li>
    </ul>
  </section>
</PublicationLayout>
