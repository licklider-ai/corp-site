---
import type { TocItem } from '../../consts';
import { AGENT_DOCS } from '../../data/agent-docs';
import {
  PAIRED_T_BOUNDARY,
  PRODUCT_RELEASE_BOUNDARY,
  PUBLIC_CAPABILITY,
  PUBLIC_RELEASE,
} from '../../data/site-facts';
import PageLayout from '../../layouts/PageLayout.astro';

const toc: TocItem[] = [
  { id: 'start', label: 'Use nomue now' },
  { id: 'current', label: 'Choose a path' },
  { id: 'documentation', label: 'Documentation' },
  { id: 'for-agents', label: 'For agents' },
  { id: 'authority', label: 'Authority boundary' },
];
---

<PageLayout
  title="Docs"
  description="Agent-readable documentation for bounded verification calls and current public nomue artifacts."
  toc={toc}
  markdownHref="/docs/index.md"
  llmsHref="/docs/llms.txt"
>
  <header class="page-head">
    <p class="eyebrow">Docs</p>
    <h1>Documentation for agents and the people who review their work</h1>
    <p class="standfirst">
      Run the public verifier, teach an agent when to call it, and interpret the returned
      evidence using the same versioned documentation.
    </p>
  </header>

  <section id="start" class="section">
    <p class="eyebrow">Available now</p>
    <h2>Verify a supported Release 1 Record locally</h2>
    <p class="start-lead">{PUBLIC_CAPABILITY}</p>
    <div class="start-actions">
      <a href="/docs/record-verification/">Install and run the verifier →</a>
      <a href="/docs/examples/">Work through examples →</a>
      <a href="/docs/examples.json">Fetch examples as JSON →</a>
    </div>
  </section>

  <section id="current" class="section">
    <h2>Choose the path you need</h2>
    <div class="status-grid">
      <article>
        <p class="eyebrow">Run</p>
        <h3>Verify a nomue Record</h3>
        <p>{`Use verifier ${PUBLIC_RELEASE.verifierPackage} for the ${PUBLIC_RELEASE.profile} profile under the ${PUBLIC_RELEASE.procedure}.`}</p>
        <p><a href="/docs/record-verification/">Verifier guide →</a></p>
      </article>
      <article>
        <p class="eyebrow">Call</p>
        <h3>Teach an agent when to verify</h3>
        <p>Use the when-to-use rules, stop triggers, decision vocabulary, and machine-readable examples.</p>
        <p><a href="/docs/verification-call/">Verification-call guide →</a></p>
      </article>
      <article>
        <p class="eyebrow">Interpret</p>
        <h3>Understand the returned result</h3>
        <p>Keep pass, fail, clarification, refusal, unsupported scope, and operational failure distinct.</p>
        <p><a href="/docs/decision-vocabulary/">Decision vocabulary →</a></p>
      </article>
    </div>
    <div class="availability-note">
      <p><strong>Product access:</strong> {PRODUCT_RELEASE_BOUNDARY}</p>
      <p><strong>Next method:</strong> {PAIRED_T_BOUNDARY}</p>
    </div>
  </section>

  <section id="documentation" class="section">
    <h2>Documentation</h2>
    <div class="doc-list">
      {
        AGENT_DOCS.map((doc) => (
          <article>
            <h3><a href={`/docs/${doc.slug}/`}>{doc.title}</a></h3>
            <p>{doc.description}</p>
            <p class="doc-status">{doc.status}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section id="for-agents" class="section">
    <h2>For agents</h2>
    <p>
      Every documentation page has a clean Markdown version. The indexes stay short so
      an agent can discover the relevant page and fetch only the detail it needs.
      Normalized examples are also available as JSON.
    </p>
    <ul>
      <li><a href="/llms.txt">Site llms.txt</a></li>
      <li><a href="/docs/llms.txt">Documentation llms.txt</a></li>
      <li><a href="/docs/index.md">Documentation index in Markdown</a></li>
      <li><a href="/docs/examples.json">Machine-readable examples</a></li>
    </ul>
  </section>

  <section id="authority" class="section">
    <h2>Authority boundary</h2>
    <p>
      These pages do not replace the public nomue Protocol or the released verifier
      artifacts. Protocol semantics, exact interpretation bundles, checks, and
      verification-report behavior remain authoritative in the Protocol repository.
      Product-call guidance explains the Layer 2 interface without redefining Layer 1.
    </p>
    <p>
      If a website explanation conflicts with the pinned Protocol or current product
      contract, treat the conflict as a documentation defect rather than resolving it
      by interpretation.
    </p>
  </section>
</PageLayout>

<style>
  .page-head {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .page-head .eyebrow {
    margin: 0;
  }

  .page-head h1 {
    font-size: clamp(1.9rem, 3.6vw, 2.6rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0.9rem 0 1.25rem;
  }

  .standfirst {
    margin: 0;
    font-size: 1.08rem;
    color: var(--ink-2);
  }

  .section {
    padding: 2.75rem 0;
    border-bottom: 1px solid var(--rule-faint);
  }

  .section h2 {
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }

  .section > :last-child,
  article > :last-child {
    margin-bottom: 0;
  }

  .start-lead { max-width: 46rem; color: var(--ink-1); font-size: 1.08rem; }

  .start-actions { display: flex; flex-wrap: wrap; gap: 0.8rem 1.5rem; margin-top: 1.75rem; }

  .start-actions a:first-child { padding: 0.6rem 0.8rem; background: var(--ink); color: var(--paper); text-decoration: none; }

  .status-grid,
  .doc-list {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .status-grid article,
  .doc-list article {
    padding: 1.2rem 1.25rem;
    border: 1px solid var(--rule);
  }

  article h3 {
    margin: 0.45rem 0 0.65rem;
    font-size: 1.02rem;
  }

  .doc-status {
    color: var(--ink-3);
    font-size: 0.82rem;
  }

  .availability-note { max-width: 46rem; margin-top: 1.5rem; padding: 1rem 1.2rem; background: var(--wash); color: var(--ink-2); font-size: 0.88rem; }

  .availability-note p:last-child { margin-bottom: 0; }
</style>
