---
import LayerDiagram from '../components/LayerDiagram.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// トップページはサイドメニューとページ内メニューを持たない。
// 本文は仮執筆 v0.1 の全文。省略せずドラフトのまま掲載する。英語化時に差し替える。
// (ドラフト末尾の「執筆メモ」はサイト非掲載の指定のため含めない)
const layers = [
  {
    n: 'Layer 1',
    title: 'nomue Record（公開仕様）と検証器',
    body: '研究成果物——図、Legend、Methods、Results、Claim——が、どの入力データ、どの利用者宣言、どの統計規則、どの計算から生成されたかを記録する公開形式。付属するオープンソースの検証器（verifier）は、Recordの内部整合を、当社のソフトウェアに依存せずに第三者が独立して検証できる。',
  },
  {
    n: 'Layer 2',
    title: 'nomue（アプリケーション）',
    body: 'Recordを正本として研究成果物を生成・維持する実行環境。研究データと研究意図から、解析、図、Legend、Methods、Results、Claimを同一の根拠の上に生成する。データ・宣言・解析のいずれかが変更されたとき、影響を受ける成果物を無効化し、再生成する。',
  },
];

const researchNotes = [
  '検証の非対称性——生成は安く、検証は高い',
  '形式承認はなぜ責任を運べないのか',
  '再現性は成果物の性質ではなく、生成過程の性質である',
];

const publicRecord = [
  { date: '2026-09', commitment: 'nomue Record v0 Public Draft を公開する', status: '予定' },
];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">アジェンダ</p>
      <h1>AI駆動時代の<br />責任の設計</h1>
      <div class="lede">
        <p>
          生成のコストは、ゼロに近づいている。<br />
          人間に残る仕事は、承認することと、責任を引き受けることである。
        </p>
        <p>Lickliderは、その責任を工学的に成立させるための基盤をつくる。</p>
      </div>
      <p class="cta">
        <a href="/thesis/">Thesisを読む →</a>
        <span class="placeholder" title="準備中">nomue（製品）→</span>
      </p>
    </div>
  </section>

  <div class="sections">
    <section class="band band--single">
      <div class="band-inner">
        <p class="eyebrow">Thesis</p>
        <div class="band-body">
        <p>
          AIは、解析、図表、文章、コードといった知的成果物を、人間の生産速度をはるかに超えて生成するようになった。生成が希少だった時代に設計された検証と承認の制度は、この変化に追随していない。成果物の量が人間の検証能力を超えるとき、律速段階は生成ではなく、承認へ移る。
        </p>
        <p>
          承認が律速になると、承認は形式化する。人間は根拠を十分に検証できないまま署名し、その署名は、問題が生じたときに責任を確定する力を失っていく。責任は、署名によってではなく、検証可能な根拠への接続によって成立する。根拠から切り離された承認は、責任の移転ではなく、責任の空洞化を招く。
        </p>
        <p>
          私たちは、責任そのものを自動化しようとしているのではない。責任が実質を持つための条件を、工学的に設計しようとしている。私たちはこれを「責任の設計」と呼ぶ。ソフトウェア工学が型検査、継続的インテグレーション、監査ログによって、正しさの一部を人間の注意力ではなく機械的な検証に委ねてきたように、AIが生成する知的成果物にも、根拠と成果物の整合を機械的に維持し、第三者が独立に検証できる層が必要である。
        </p>
        <p>
          Lickliderは、この層を科学研究から作り始める。科学では、誰が主張に責任を持つかだけでなく、その主張がどのデータ、解析、判断に基づくのかが問われる。主張と根拠の接続が、成果物そのものの成立条件になっているからである。この環境で成立する仕組みは、やがて規制、監査、医療、金融、そしてAIが関与する意思決定へと拡張できる。
        </p>
        <p>
          AI時代に必要なのは、より多く生成するための層だけではない。生成されたものに、人間が責任を持てるようにするための層である。
        </p>
        <p class="more"><a href="/thesis/">Thesis のページへ →</a></p>
        </div>
      </div>
    </section>

    <section class="band band--single">
      <div class="band-inner band-inner--wide">
        <p class="eyebrow">What We Build</p>
        <LayerDiagram layers={layers} />

        <div class="band-body">
          <p class="lead">
            信頼は、生成物ではなく記録に宿る。生成は利便のための層であり、記録と検証が本体である。
          </p>

          <p class="more"><span class="placeholder" title="準備中">→ nomue 製品サイトへ</span></p>
        </div>
      </div>
    </section>

    <section class="band">
      <p class="eyebrow">Open Specification &amp; Verifier</p>
      <div class="band-body">
        <p class="lead">私たちの主張を、信頼する必要はない。検証してほしい。</p>
        <ul class="resources">
          <li>
            <strong>nomue Record v0</strong> — 公開仕様（Public Draft、2026年9月公開予定）
            <span class="placeholder">[リンク]</span>
          </li>
          <li>
            <strong>nomue verifier</strong> — オープンソースの独立検証器
            <span class="placeholder">[GitHub]</span>
          </li>
          <li>
            <strong>Changelog</strong> — 仕様のすべての変更履歴 <span class="placeholder">[リンク]</span>
          </li>
        </ul>
        <p>
          仕様と検証器を公開するのは、透明性の演出のためではない。記録形式が特定の企業の生存に依存しないこと自体が、責任のインフラの要件だからである。
        </p>
      </div>
    </section>

    <section class="band">
      <p class="eyebrow">Research Notes</p>
      <div class="band-body">
        <p>責任の設計に関する短い技術的エッセイ。各稿は日付と版番号を持つ。</p>
        <ul class="notes">
          {
            researchNotes.map((note) => (
              <li>
                {note} <span class="placeholder">[準備中]</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="band">
      <p class="eyebrow">Why "Licklider"</p>
      <div class="band-body">
        <p>
          J. C. R. Licklider は "Man-Computer Symbiosis"（1960）において、人間が目標を設定し判断を担い、計算機が定型的な作業を担うという分業を、最初に定式化した。
        </p>
        <p>
          それから66年。生成は機械の側へ移り、承認と責任は人間の側に残った。しかし、この分業を成立させるための基盤は、いまだ存在しない。
        </p>
        <p>社名は、この分業の最初の設計図への参照である。</p>
      </div>
    </section>

    <section class="band">
      <p class="eyebrow">Public Record</p>
      <div class="band-body">
        <p>
          責任の設計を語る企業として、当社自身の公開コミットメントをここに記録する。宣言、達成、未達、変更のすべてを残す。
        </p>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">日付</th>
                <th scope="col">宣言</th>
                <th scope="col">状態</th>
              </tr>
            </thead>
            <tbody>
              {
                publicRecord.map((row) => (
                  <tr>
                    <td>{row.date}</td>
                    <td>{row.commitment}</td>
                    <td>{row.status}</td>
                  </tr>
                ))
              }
              <tr class="placeholder">
                <td>[以後追記]</td>
                <td></td>
                <td></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="band">
      <p class="eyebrow">Company</p>
      <div class="band-body">
        <dl class="company">
          <dt>商号</dt>
          <dd class="placeholder">[株式会社Licklider ／ Licklider, Inc. — 正式表記要確認]</dd>
          <dt>所在地</dt>
          <dd>東京、日本 <span class="placeholder">[要確定]</span></dd>
          <dt>代表</dt>
          <dd class="placeholder">[氏名]</dd>
          <dt>連絡</dt>
          <dd><a href="mailto:contact@licklider.ai">contact@licklider.ai</a></dd>
        </dl>
        <p class="colophon placeholder">[設立年・登記情報など、コロフォン調で最小限に]</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--rule-faint);
  }

  .hero-inner {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 7rem var(--gutter) 6rem;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4.25rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 1.25rem 0 2.5rem;
  }

  .lede {
    max-width: var(--measure);
    font-size: 1.12rem;
    color: var(--ink-1);
  }

  .cta {
    margin-top: 3rem;
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    font-size: 0.95rem;
  }

  .cta a {
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 3px;
  }

  .cta a:hover {
    border-bottom-color: var(--ink-3);
  }

  .sections {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .band {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 3rem;
    padding: 4rem 0;
    border-bottom: 1px solid var(--rule-faint);
  }

  .band:last-child {
    border-bottom: 0;
  }

  .band > .eyebrow {
    margin: 0.35rem 0 0;
  }

  .band-body {
    max-width: var(--measure);
  }

  /* 1 ペインの段。見出しを本文の上に置き、内容ごと中央に寄せる。
     幅は 2 ペイン時の本文列と同じに保つ */
  .band--single {
    display: block;
  }

  .band-inner {
    max-width: var(--measure);
    margin: 0 auto;
  }

  /* 図の段は、2 ペイン時の 2 列目 (シェル 71rem − 見出し 12rem − 間隔 3rem) と同じ幅 */
  .band-inner--wide {
    max-width: 56rem;
  }

  .band-inner > .eyebrow {
    margin: 0 0 2.5rem;
  }

  .band-inner--wide .band-body {
    margin-top: 3rem;
  }

  .band-body > :last-child {
    margin-bottom: 0;
  }

  .lead {
    font-size: 1.08rem;
    color: var(--ink);
  }

  strong {
    font-weight: 400;
    border-bottom: 1px solid var(--rule);
  }

  .more {
    margin-top: 1.75rem;
    font-size: 0.95rem;
  }

  .resources,
  .notes {
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
    font-size: 0.95rem;
  }

  .resources li,
  .notes li {
    padding: 0.75rem 0;
    border-top: 1px solid var(--rule-faint);
    color: var(--ink-2);
  }

  .resources strong {
    color: var(--ink);
    border-bottom: 0;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .company {
    margin: 0;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    row-gap: 0.5rem;
    font-size: 0.95rem;
  }

  .company dt {
    color: var(--ink-3);
    font-size: 0.85rem;
    padding-top: 0.15rem;
  }

  .company dd {
    margin: 0;
  }

  .colophon {
    margin: 1.5rem 0 0;
    font-size: 0.9rem;
  }

  @media (max-width: 800px) {
    .hero-inner {
      padding: 4rem var(--gutter) 3.5rem;
    }

    .band {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
      padding: 3rem 0;
    }

  }
</style>
