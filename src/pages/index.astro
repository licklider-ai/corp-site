---
import { PUBLICATIONS } from '../data/publications';
import { UPSTREAM_CONTRIBUTIONS } from '../data/site-facts';
import { SCIGROUND, ENTRY_POINTS, RESEARCH_SCOPE, SCIGROUND_FAQ } from '../data/sciground';
import BaseLayout from '../layouts/BaseLayout.astro';
import SampleReport from '../components/SampleReport.astro';
import '../styles/sciground.css';
const papers = PUBLICATIONS.filter(p => p.category === 'Research' && p.type === 'Publication').sort((a,b) => b.sortKey.localeCompare(a.sortKey));
const latest = [...PUBLICATIONS].sort((a,b) => b.sortKey.localeCompare(a.sortKey)).slice(0,8);
const entries = ['analysis','data','design'].map(id => ENTRY_POINTS.find(e => e.id === id)!);
const fits = [
  {id:'two-groups', name:'Treatment & control', example:'Animal body weight · assay readings', detail:'Independent groups. One continuous outcome. One specified comparison.', shape:'groups'},
  {id:'paired', name:'Before & after', example:'Two measurements per individual', detail:'Complete pairs at two time points, with the same outcome and a fixed direction.', shape:'paired'},
  {id:'multiple-groups', name:'Multiple treatments', example:'One factor · planned comparisons', detail:'Independent groups with the comparisons and multiplicity adjustment specified.', shape:'multi'},
  {id:'rna-seq', name:'Bulk RNA-seq', example:'Gene expression · raw count tables', detail:'Two independent groups, one comparison, one batch, and a defined pipeline.', shape:'rna'},
];
const structuredData = {'@type':'WebPage','@id':new URL('/#webpage',Astro.site).href,name:'SciGround — From Design to Claim',description:SCIGROUND.description,url:new URL('/',Astro.site).href,dateModified:SCIGROUND.updated,isPartOf:{'@id':new URL('/#website',Astro.site).href}};
---
<BaseLayout structuredData={structuredData}>
<div class="sg-home">
  <section class="sg-hero" aria-labelledby="hero-title">
    <div class="sg-container">
      <div class="sg-hero-top"><p class="sg-wordmark">SciGround<span>by Licklider</span></p><p class="sg-kicker">For life sciences research</p></div>
      <h1 id="hero-title"><span class="sg-quote">“I finished your analysis,”<br class="sg-wide-break" /> says your AI.</span><span class="sg-answer">Your doubts say otherwise.</span></h1>
      <div class="sg-hero-bottom"><p class="sg-hero-description">{SCIGROUND.description}</p><div><div class="sg-actions"><a class="sg-button" href="#example">See an example <span aria-hidden="true">↓</span></a><a class="sg-text-link" href="/docs/sciground-connect/">Start with your analysis <span aria-hidden="true">↗</span></a></div><p class="sg-fine">Choose your AI tool and follow the setup guide.</p></div></div>
      <div class="sg-hero-rule"><span>Mathematical verification.</span><span>From design to claim.</span></div>
    </div>
  </section>

  <section id="example" class="sg-section sg-example-section" aria-labelledby="example-title">
    <div class="sg-container">
      <div class="sg-section-head"><p class="sg-kicker">01 / Beyond the calculation</p><h2 id="example-title">A correct calculation can still<br class="sg-wide-break" /> use the wrong data.</h2><p class="sg-lead">SciGround checks that the samples, groups, and values used in your analysis match the source records you provide.</p></div>
      <div class="sg-demo" data-example>
        <div class="sg-demo-top"><span>Two-group body-weight comparison</span><span class="sg-demo-label">Illustrative example · synthetic data</span></div>
        <div class="sg-demo-body">
          <div class="sg-demo-story"><p class="sg-kicker" data-step-label>01 / A mismatch found</p><h3 data-step-title>Same animal.<br />Different group.</h3><p data-step-description>The calculation used M17 in the treatment group. The supplied source record places it in control.</p><button class="sg-button sg-demo-button" data-example-next type="button" hidden>Review the correction <span aria-hidden="true">→</span></button><a class="sg-text-link sg-report-jump" href="#report" data-report-jump hidden>See the corrected report <span aria-hidden="true">↓</span></a><noscript><p>After the researcher confirms the source-based correction, the analysis is rerun with M17 in Control. The corrected result appears below.</p></noscript></div>
          <div class="sg-data-comparison"><div class="sg-source-heading"><span>Source record</span><span>Analysis input</span></div><div class="sg-source-table"><div><span class="sg-table-label">Animal / Group</span><p>M16 <span>Treatment</span></p><p class="sg-mismatch">M17 <strong>Control</strong></p><p>M18 <span>Treatment</span></p></div><div><span class="sg-table-label">Animal / Group</span><p>M16 <span>Treatment</span></p><p class="sg-mismatch" data-mismatch>M17 <strong data-analysis-group>Treatment</strong></p><p>M18 <span>Treatment</span></p></div></div><div class="sg-demo-status" aria-live="polite" data-example-status><span aria-hidden="true">↳</span> Group assignment differs from the supplied record.</div><p class="sg-fine">Source agreement can be checked. The actual experiment and sample independence remain research assumptions.</p></div>
        </div>
        <div class="sg-demo-progress" aria-label="Example stages"><span data-step="0" aria-current="step">01 <span>Find the mismatch</span></span><span data-step="1">02 <span>Confirm the correction</span></span><span data-step="2">03 <span>Regenerate the result</span></span></div>
      </div>
      <div id="verification" class="sg-role-note"><p><strong>You ask your AI.</strong> SciGround performs the analysis and verification. Your AI explains the results.</p><p>The verification outcome comes from defined checks—not an AI’s assessment of its own answer.</p></div>
    </div>
  </section>

  <section id="report" class="sg-section sg-report-section" aria-labelledby="report-title">
    <div class="sg-container">
      <div class="sg-section-head sg-split-head"><div><p class="sg-kicker">02 / The result you take with you</p><h2 id="report-title">Results you can share.<br /><em>Evidence they can follow.</em></h2></div><p class="sg-lead">Get a clear report of the findings, methods, and limits. Your collaborators can follow each result back to the data and conditions behind it.</p></div>
      <SampleReport />
      <div class="sg-report-footer"><a class="sg-text-link" href="/examples/group-comparison/">Explore the sample report <span aria-hidden="true">↗</span></a><p>Same study. Corrected groups. A new result with its own evidence.</p></div>
      <div class="sg-revision-note"><span aria-hidden="true">↳</span><div><h3>A correction shouldn’t leave you guessing.</h3><p>When data or settings change, affected results go through verification again. Each version keeps its own evidence, so earlier findings remain distinguishable from those that apply now.</p></div><a class="sg-button" href="/docs/sciground-connect/">Start with your analysis <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section id="start" class="sg-section" aria-labelledby="start-title"><div class="sg-container sg-entry-layout"><div><p class="sg-kicker">03 / Your starting point</p><h2 id="start-title">Start with<br /><em>what you have.</em></h2><p class="sg-lead">You don’t have to start your research over.</p></div><div class="sg-entry-list">{entries.map((entry,index) => <a href={entry.href}><span class="sg-entry-number">0{index+1}</span><div><h3>{entry.title}</h3><p>{entry.id==='analysis' ? 'Bring your source data, settings, and existing results. Find out what holds—and what needs attention.' : entry.id==='data' ? 'Match measurements to samples and groups before they become an analysis.' : 'Clarify the comparison, experimental units, and sample-size assumptions before collecting data.'}</p></div><span class="sg-entry-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>

  <section id="scope" class="sg-section sg-fit-section" aria-labelledby="scope-title"><div class="sg-container"><div class="sg-section-head sg-split-head"><div><p class="sg-kicker">04 / Research fit</p><h2 id="scope-title">Familiar questions.<br />Defined conditions.</h2></div><p class="sg-lead">Built around comparison studies in the life sciences. Start with the question that looks like yours.</p></div><div class="sg-fit-grid">{fits.map((fit,i) => <a href={`/docs/sciground-scope/#${fit.id}`}><div class={`sg-fit-glyph sg-glyph-${fit.shape}`} aria-hidden="true">{Array.from({length:12},(_,n) => <i style={`--n:${n};--i:${i}`}></i>)}</div><h3>{fit.name}<span aria-hidden="true">↗</span></h3><p class="sg-fit-example">{fit.example}</p><p>{fit.detail}</p></a>)}</div><details class="sg-more-workflows"><summary>More research workflows <span aria-hidden="true">+</span></summary><div>{RESEARCH_SCOPE.filter(item => !fits.some(fit=>fit.id===item.id)).map(item=><a href={`/docs/sciground-scope/#${item.id}`}>{item.title}<span aria-hidden="true">↗</span></a>)}<a href="/docs/sciground-scope/#sample-removal">Sample-removal stability <span aria-hidden="true">↗</span></a></div></details><p class="sg-fine">Each workflow has its own input requirements and boundaries. Features cannot all be combined freely. <a href="/docs/sciground-scope/">Explore the full scope.</a></p></div></section>

  <section id="evidence" class="sg-section sg-evidence" aria-labelledby="evidence-title"><div class="sg-container"><div class="sg-evidence-intro"><div><p class="sg-kicker">05 / The basis for confidence</p><h2 id="evidence-title">New ways to work.<br /><em>Established ways to know.</em></h2></div><div><p class="sg-lead">AI makes the work easier to ask for. Defined methods and mathematical verification establish what the results support.</p><p>Every result has a target, conditions, and limits. Numerical checks and evidence links keep those boundaries attached as the research moves forward.</p><a class="sg-text-link" href="/docs/sciground-verification/">How verification works <span aria-hidden="true">↗</span></a></div></div><div class="sg-research-band"><div><h3>Examine the work.</h3><p>Methods, findings, and reproducible reports—published in the open.</p><a class="sg-text-link" href="/research/">All research <span aria-hidden="true">↗</span></a></div><div class="sg-paper-list">{papers.slice(0,2).map(paper=><a href={paper.href}><span class="sg-kicker">Research / Publication</span><h4>{paper.title.replace(/ — preprint v[\d.]+$/, '')}</h4><span class="sg-paper-status">{paper.status}</span><span class="sg-paper-arrow" aria-hidden="true">↗</span></a>)}</div></div><div class="sg-upstream-strip"><p><strong>{UPSTREAM_CONTRIBUTIONS.length}</strong> upstream reports <span>·</span> <strong>{UPSTREAM_CONTRIBUTIONS.filter(i=>i.outcome==='fix_merged').length}</strong> fixes merged</p><a class="sg-text-link" href="/engineering/">Improving the software research relies on <span aria-hidden="true">↗</span></a></div><p class="sg-fine">Publications retain their original scope and status. Earlier nomue work is not end-to-end evidence for SciGround.</p><details class="sg-latest"><summary>Latest <span>Research, engineering, and company updates</span></summary><ol>{latest.map(row=><li><time datetime={row.sortKey}>{row.date}</time><a href={row.href}>{row.title}</a><span>{row.category}</span></li>)}</ol><a class="sg-text-link" href="/latest/">All updates <span aria-hidden="true">↗</span></a></details></div></section>

  <section id="faq" class="sg-section sg-faq" aria-labelledby="faq-title"><div class="sg-container sg-faq-layout"><div><p class="sg-kicker">06 / Before you begin</p><h2 id="faq-title">Good questions.</h2></div><div class="sg-faq-list">{SCIGROUND_FAQ.map(item=><details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></div><div id="connect" class="sg-container sg-final"><p class="sg-kicker">SciGround / From Design to Claim</p><h2>We bet on you.</h2><p>Bring your next analysis.<br />Keep the evidence with the result.</p><a class="sg-button" href="/docs/sciground-connect/">Start with your analysis <span aria-hidden="true">↗</span></a><p class="sg-fine">Choose your AI tool and follow the setup guide.</p></div></section>
</div>
</BaseLayout>
<script>
const demo=document.querySelector<HTMLElement>('[data-example]');
if(demo){
 const next=demo.querySelector<HTMLButtonElement>('[data-example-next]')!;
 next.hidden=false;
 let step=0;
 const labels=['01 / A mismatch found','02 / Your confirmation','03 / A new result'];
 const titles=['Same animal.<br>Different group.','The source is clear.<br>You confirm the change.','Corrected groups.<br>Regenerated results.'];
 const descriptions=['The calculation used M17 in the treatment group. The supplied source record places it in control.','The proposed correction moves M17 to Control. The source record is retained; a researcher confirms the change before a new analysis.','M17 is back in Control. The corrected input has 10 animals in each group. The report below shows this new result.'];
 const statuses=['Group assignment differs from the supplied record.','Proposed change: M17 · Treatment → Control.','Corrected input matches the supplied group record.'];
 next.addEventListener('click',()=>{
  step=(step+1)%3;
  demo.dataset.state=String(step);
  demo.querySelector<HTMLElement>('[data-report-jump]')!.hidden=step!==2;
  demo.querySelector('[data-step-label]')!.textContent=labels[step];
  demo.querySelector('[data-step-title]')!.innerHTML=titles[step];
  demo.querySelector('[data-step-description]')!.textContent=descriptions[step];
  demo.querySelector('[data-example-status]')!.textContent=statuses[step];
  demo.querySelector('[data-analysis-group]')!.textContent=step===2?'Control':'Treatment';
  next.innerHTML=[`Review the correction <span aria-hidden="true">→</span>`,`Confirm in this example <span aria-hidden="true">→</span>`,`Replay the example <span aria-hidden="true">↺</span>`][step];
  demo.querySelectorAll('[data-step]').forEach((el,i)=>i===step?el.setAttribute('aria-current','step'):el.removeAttribute('aria-current'));
 });
}
</script>
