---
import { PUBLICATIONS } from '../data/publications';
import { PUBLIC_RELEASE } from '../data/site-facts';
import BaseLayout from '../layouts/BaseLayout.astro';

const latest = [...PUBLICATIONS]
  .sort((a, b) => b.sortKey.localeCompare(a.sortKey))
  .slice(0, 3);

const verifierStructuredData = {
  '@type': 'SoftwareApplication',
  '@id': new URL('/#nomue-verifier', Astro.site).href,
  name: 'nomue verifier',
  applicationCategory: 'ScientificApplication',
  operatingSystem: PUBLIC_RELEASE.supportedOperatingSystems.join(', '),
  softwareVersion: PUBLIC_RELEASE.verifierPackage,
  description:
    'npm-published open-source local verification for supported nomue Release 1 Welch Records.',
  url: new URL('/docs/record-verification/', Astro.site).href,
  downloadUrl: PUBLIC_RELEASE.npmUrl,
  codeRepository: PUBLIC_RELEASE.verifierUrl,
  softwareRequirements: `Node.js ${PUBLIC_RELEASE.testedNodeVersions.join(' or ')}`,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  provider: { '@id': new URL('/#organization', Astro.site).href },
  featureList: [
    'Local and offline Record verification',
    'Welch result recomputation',
    'Machine-readable scoped verification reports',
    'Local Record canonical digest projection',
    'Local Record content digest recomputation',
  ],
};

const homeStructuredData = {
  '@type': 'WebPage',
  '@id': new URL('/#webpage', Astro.site).href,
  name: 'Licklider — Determinize AI',
  description:
    'Licklider builds nomue to check AI-generated claims independently. Public support begins with Welch analyses; life sciences, finance, and chemistry are long-term directions.',
  url: new URL('/', Astro.site).href,
  dateModified: '2026-09-24',
  isPartOf: { '@id': new URL('/#website', Astro.site).href },
  about: { '@id': new URL('/#nomue-verifier', Astro.site).href },
};
---

<BaseLayout description={homeStructuredData.description} structuredData={[homeStructuredData, verifierStructuredData]}>
  <section class="hero">
    <div class="hero-inner">
      <h1>Determinize AI.</h1>
      <p class="hero-lede">
        nomue checks AI-generated claims independently, so people and agents can act on evidence.
      </p>
      <p class="hero-scope">Life sciences. Finance. Chemistry. Wherever claims must hold.</p>
      <div class="cta">
        <a class="cta-primary" href="#scope">Explore the scope</a>
        <a href="#evidence">View the evidence</a>
      </div>
    </div>
  </section>

  <div class="sections">
    <section class="band thesis-band">
      <p class="eyebrow">Why</p>
      <div class="band-body band-body--wide">
        <h2 class="section-title">Generation is fast. Approval is the bottleneck.</h2>
        <p class="lead">
          AI can produce analysis in seconds. Using it still requires a separate answer:
          does this result hold?
        </p>
        <p class="sequence">The model generates. <strong>nomue checks.</strong> People decide.</p>
        <p class="more"><a href="/nomue/">See how nomue works</a></p>
      </div>
    </section>

    <section id="evidence" class="band band--single evidence-band">
      <div class="band-inner band-inner--wide">
        <p class="eyebrow">Evidence</p>
        <h2 class="evidence-title">Measured, not assumed.</h2>
        <div class="evidence-grid">
          <article>
            <p class="metric">216 / 216</p>
            <h3>Expected complete reports with nomue</h3>
            <p>
              Compared with 132 / 216 using general Python and 131 / 216 using a stable
              Welch wrapper.
            </p>
            <p class="study-scope">72 constructed Welch-report questions · three repetitions · 648 sessions</p>
            <p><a href="/evaluation/#result">View the decision-quality study</a></p>
          </article>
          <article>
            <div class="paired-metrics" aria-label="Measured cost and time reductions">
              <p><span class="metric">78.1%</span><span>lower API cost</span></p>
              <p><span class="metric">62.9%</span><span>less task time</span></p>
            </div>
            <h3>With nomue, compared with ordinary tools alone</h3>
            <p>
              Measured across 103 matched pairs where both configurations reached the
              correct answer.
            </p>
            <p class="study-scope">48 synthetic Welch tasks · three repetitions · 288 scheduled sessions</p>
            <p><a href="/evaluation/#historical-reuse">View the cost-and-time study</a></p>
          </article>
        </div>
        <p class="evidence-boundary">
          These results apply to the tested Welch workflows. Both studies were led by
          nomue's developer and published as preprints, not peer-reviewed findings.
        </p>
        <p class="more"><a href="/evaluation/">View all evidence</a></p>
      </div>
    </section>

    <section id="scope" class="band band--single scope-band">
      <div class="band-inner band-inner--wide">
        <p class="eyebrow">Scope</p>
        <h2 class="scope-title">Proven narrowly. Built to expand.</h2>
        <div class="scope-grid home-scope-grid">
          <article>
            <p class="scope-label">Available today</p>
            <h3>Welch checks on your own machine</h3>
            <p>
              The public nomue package checks supported two-sided Welch analyses locally
              on Linux, macOS and Windows.
            </p>
            <p>
              Hosted Welch checks are available to approved recipients in limited Release 1.
            </p>
            <p><a href="/docs/record-verification/">Use nomue today</a></p>
          </article>
          <article>
            <p class="scope-label">Long-term direction</p>
            <h3>Life sciences. Finance. Chemistry.</h3>
            <p>
              The long-term scope is any field where AI-generated claims can be checked
              against declared data, calculations or rules.
            </p>
            <p>
              Each new capability will state what it checks, the evidence behind it and
              where it stops.
            </p>
            <p><a href="/roadmap/">Explore the scope</a></p>
          </article>
        </div>
      </div>
    </section>

    <section id="latest" class="band follow-band">
      <p class="eyebrow">Follow the evidence</p>
      <div class="band-body latest-body">
        <p class="follow-copy">New results are published with their tested scope, evidence and limits.</p>
        <ol class="latest-list">
          {
            latest.map((row) => (
              <li>
                <span class="latest-date">{row.date}</span>
                <a class="latest-title" href={row.href}>{row.title}</a>
                <span class="latest-category">
                  <a href={`/${row.category.toLowerCase()}/`}>{row.category}</a>
                </span>
              </li>
            ))
          }
        </ol>
        <p class="more"><a class="link-button" href="/latest/">All updates</a> · <a href="/research/">Research</a> · <a href="/engineering/">Engineering</a></p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
@layer legacy {
  .hero { border-bottom: 1px solid var(--rule-faint); }
  .hero-inner { max-width: var(--shell); margin: 0 auto; padding: clamp(5rem, 10vw, 9rem) var(--gutter) clamp(4rem, 8vw, 7rem); }
  .hero h1 { max-width: 72rem; margin: 0; font-size: clamp(4.1rem, 10vw, 9rem); line-height: 0.95; letter-spacing: -0.045em; }
  .hero-lede { max-width: 47rem; margin: 3rem 0 0; color: var(--ink-1); font-size: clamp(1.25rem, 2.25vw, 1.75rem); line-height: 1.5; }
  .hero-scope { margin: 1.25rem 0 0; color: var(--ink-3); font-size: 1rem; }
  .cta { display: flex; gap: 1rem 1.75rem; flex-wrap: wrap; align-items: center; margin-top: 3rem; font-size: 0.95rem; }
  .cta a { padding-bottom: 3px; border-bottom: 1px solid var(--ink); text-decoration: none; }
  .cta .cta-primary { padding: 0.8rem 1.15rem; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); }

  .sections { max-width: var(--shell); margin: 0 auto; padding: 0 var(--gutter); }
  .band { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 4rem; padding: clamp(4rem, 7vw, 6.5rem) 0; border-bottom: 1px solid var(--rule-faint); }
  .band:last-child { border-bottom: 0; }
  .band > .eyebrow { margin: 0.35rem 0 0; }
  .band--single { display: block; }
  .band-inner--wide > .eyebrow { margin-bottom: 2rem; }
  .band-body { max-width: var(--measure); }
  .band-body--wide { max-width: 56rem; }
  .lead { color: var(--ink); font-size: clamp(1.2rem, 2vw, 1.5rem); }
  .section-title, .evidence-title, .scope-title { max-width: 60rem; margin: 0 0 1.5rem; font-size: clamp(2rem, 4.5vw, 3.8rem); line-height: 1.12; }
  .sequence { margin: 2.5rem 0 0; font-size: clamp(1.35rem, 2.5vw, 2rem); }
  .sequence strong { color: var(--blue); font-weight: 400; }

  .evidence-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 2.5rem; border: 1px solid var(--rule); background: var(--rule); }
  .evidence-grid article { padding: clamp(1.75rem, 4vw, 3rem); background: var(--paper); }
  .evidence-grid h3 { margin: 1.5rem 0 0.85rem; font-size: 1.4rem; }
  .metric { margin: 0; color: var(--gold-ink); font-size: clamp(3rem, 6vw, 5.5rem); line-height: 0.95; letter-spacing: -0.035em; }
  .paired-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .paired-metrics p { margin: 0; }
  .paired-metrics span { display: block; }
  .paired-metrics span:last-child { margin-top: 0.7rem; color: var(--ink-2); font-size: 0.9rem; }
  .study-scope { color: var(--ink-3); font-size: 0.85rem; }
  .evidence-boundary { max-width: 55rem; margin: 2rem 0 0; color: var(--ink-2); }

  .scope-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 2.5rem; border: 1px solid var(--rule); background: var(--rule); }
  .scope-grid article { padding: clamp(1.75rem, 4vw, 3rem); background: var(--paper); }
  .scope-grid article:first-child { background: var(--blue-wash); box-shadow: inset 0 2px var(--gold-ink); }
  .scope-grid h3 { margin: 0 0 1rem; font-size: 1.55rem; }
  .scope-label { margin: 0 0 1.5rem; color: var(--blue); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; }

  .follow-copy { margin-top: 0; font-size: 1.15rem; }
  .latest-body { max-width: none; }
  .latest-list { list-style: none; margin: 2rem 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .latest-list li { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr) auto; gap: 1.5rem; align-items: baseline; margin: 0; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
  .latest-date { color: var(--ink-3); font-size: 0.875rem; }
  .latest-title { color: var(--ink); font-size: 1.15rem; line-height: 1.45; text-decoration: none; }
  .latest-category a { color: var(--ink-3); font-size: 0.85rem; text-decoration: none; }
  .more { margin: 2rem 0 0; font-size: 0.92rem; }

  @media (max-width: 900px) {
    .band { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .evidence-grid, .scope-grid { grid-template-columns: minmax(0, 1fr); }
    .latest-list li { grid-template-columns: 6.5rem minmax(0, 1fr); gap: 1rem; }
    .latest-category { display: none; }
  }

  @media (max-width: 620px) {
    .hero-inner { padding-top: 4rem; }
    .hero h1 { font-size: clamp(3.5rem, 19vw, 5.2rem); }
    .hero-lede { margin-top: 2rem; }
    .paired-metrics { grid-template-columns: minmax(0, 1fr); }
    .latest-list li { grid-template-columns: minmax(0, 1fr); gap: 0.2rem; }
  }
}
</style>
