---
import { PUBLICATIONS } from '../data/publications';
import { UPSTREAM_CONTRIBUTIONS } from '../data/site-facts';
import { SCIGROUND, RESEARCH_STAGES, ENTRY_POINTS, RESEARCH_SCOPE, SCIGROUND_FAQ } from '../data/sciground';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/sciground.css';

const papers = PUBLICATIONS.filter((item) => item.category === 'Research' && item.type === 'Publication')
  .sort((a, b) => b.sortKey.localeCompare(a.sortKey));
const latest = [...PUBLICATIONS].sort((a, b) => b.sortKey.localeCompare(a.sortKey)).slice(0, 8);
const upstreamFixCount = UPSTREAM_CONTRIBUTIONS.filter((item) => item.outcome === 'fix_merged').length;
const structuredData = {
  '@type': 'WebPage',
  '@id': new URL('/#webpage', Astro.site).href,
  name: 'SciGround — From Design to Claim',
  description: SCIGROUND.description,
  url: new URL('/', Astro.site).href,
  dateModified: SCIGROUND.updated,
  isPartOf: { '@id': new URL('/#website', Astro.site).href },
  about: { '@type': 'Thing', name: 'SciGround', description: SCIGROUND.description },
};
---

<BaseLayout structuredData={structuredData}>
  <div class="sg-home">
    <section class="sg-hero" aria-labelledby="hero-title">
      <div class="sg-container sg-hero-inner">
        <p class="sg-label">SciGround <span>by Licklider</span></p>
        <h1 id="hero-title">Make Your AI-Assisted Research<br class="sg-desktop-break" /> <em>Mathematically Verifiable.</em></h1>
        <p class="sg-tagline">From Design to Claim.</p>
        <div class="sg-actions">
          <a class="sg-button" href="#verification">See how it works <span aria-hidden="true">↗</span></a>
          <a class="sg-text-link" href="#start">Find your starting point <span aria-hidden="true">↓</span></a>
        </div>
        <p class="sg-hero-foot">Mathematical verification for AI-assisted life sciences research.</p>
      </div>
    </section>

    <section id="verification" class="sg-section sg-verification" aria-labelledby="verification-title">
      <div class="sg-container">
        <div class="sg-section-head">
          <p class="sg-kicker">01 / Verification, connected</p>
          <h2 id="verification-title">What can your design<br />and data support?</h2>
          <p class="sg-lead">SciGround establishes what your research materials support and under which assumptions. It checks that those conditions hold at the next stage, carrying verified evidence toward the claims you can make.</p>
        </div>
        <ol class="sg-chain" aria-label="Design to Claim, including checks between stages">
          {RESEARCH_STAGES.map((stage, index) => (
            <li>
              <article class="sg-stage">
                <div class="sg-stage-top"><span>{String(index + 1).padStart(2, '0')}</span><h3>{stage.label}</h3></div>
                <h4>{stage.question}</h4>
                <p>{stage.text}</p>
              </article>
              {stage.handoff && <div class="sg-handoff"><span class="sg-handoff-arrow" aria-hidden="true">→</span><div><strong>{stage.handoff}</strong><p>{stage.handoffText}</p></div></div>}
            </li>
          ))}
        </ol>
        <div class="sg-connection-note">
          <span class="sg-note-mark" aria-hidden="true">↳</span>
          <div><h3>The connections are checked, too.</h3><p>The samples analyzed must match the research target. The method must meet its conditions. The claim must refer to the comparison actually performed. A guarantee moves forward with the conditions that make it valid.</p></div>
        </div>
        <div class="sg-explain-grid">
          <article>
            <p class="sg-kicker">A precise meaning</p>
            <h3>What does “mathematically verified” mean?</h3>
            <p>The target and conditions are expressed as rules that calculations and logic can check. SciGround checks whether the evidence meets those rules.</p>
            <p>The AI proposes and explains. SciGround’s verification process determines what is established.</p>
            <ul class="sg-outcomes" aria-label="Distinct verification outcomes">
              <li><span class="sg-outcome-dot sg-established" aria-hidden="true"></span>Established within the stated conditions</li>
              <li><span class="sg-outcome-dot sg-conflict" aria-hidden="true"></span>A condition is not met</li>
              <li><span class="sg-outcome-dot sg-unresolved" aria-hidden="true"></span>Not enough evidence or precision to decide</li>
            </ul>
            <p class="sg-fine">Measurement reliability and sample independence remain explicit research assumptions. Mathematical verification does not remove statistical uncertainty.</p>
          </article>
          <article>
            <p class="sg-kicker">Through revisions</p>
            <h3>When the research changes,<br />check the guarantee again.</h3>
            <p>A sample value, a group assignment, a set of comparisons. Changes put the affected analyses and claims back through verification.</p>
            <div class="sg-revision" aria-label="A correction creates a new version and requires new checks">
              <div><span>Earlier version</span><strong>Record preserved</strong></div>
              <span aria-hidden="true">↓</span>
              <div><span>Data or conditions change</span><strong>Affected results need rechecking</strong></div>
              <span aria-hidden="true">↓</span>
              <div><span>New version</span><strong>A new result, with its own evidence</strong></div>
            </div>
            <p class="sg-fine">A past result and a result you can apply to the current research are kept distinct.</p>
          </article>
        </div>
        <a class="sg-text-link" href="/docs/sciground-verification/">Read the verification principles <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section id="start" class="sg-section sg-start" aria-labelledby="start-title">
      <div class="sg-container">
        <div class="sg-section-head">
          <p class="sg-kicker">02 / Your starting point</p>
          <h2 id="start-title">Start with what you have.</h2>
          <p class="sg-lead">A study you are planning. Data you have collected. An analysis already in progress. Begin with the available materials and establish what can be checked.</p>
        </div>
        <div class="sg-entry-grid">
          {ENTRY_POINTS.map((entry) => <article>
            <span class="sg-entry-number" aria-hidden="true">{entry.number}</span>
            <h3>{entry.title}</h3>
            <p>{entry.description}</p>
            <div class="sg-example"><span>For example</span><p>{entry.example}</p></div>
            <a class="sg-text-link" href={entry.href}>{entry.link} <span aria-hidden="true">↗</span></a>
          </article>)}
        </div>
        <div class="sg-deliverable"><h3>A result, with its basis.</h3><p>Receive methods, result tables, supported claims, assumptions, and limits together. Share them with collaborators alongside the evidence and instructions to check the recorded result.</p></div>
      </div>
    </section>

    <section id="scope" class="sg-section sg-scope" aria-labelledby="scope-title">
      <div class="sg-container">
        <div class="sg-section-head sg-split-head">
          <div><p class="sg-kicker">Research fit</p><h2 id="scope-title">Does it fit<br />your research?</h2></div>
          <p class="sg-lead">Built around comparison studies in the life sciences. Each workflow has defined inputs, assumptions, and verification boundaries.</p>
        </div>
        <div class="sg-scope-list">
          {RESEARCH_SCOPE.map((item) => <a href={`/docs/sciground-scope/#${item.id}`}><h3>{item.title}</h3><p>{item.summary}</p><span aria-hidden="true">↗</span></a>)}
        </div>
        <p class="sg-fine sg-scope-note">Each workflow has its own conditions. Listed methods and features cannot all be combined freely. <a href="/docs/sciground-scope/">Read the input requirements and scope</a>.</p>
        <aside class="sg-stability">
          <div><p class="sg-kicker">A further check</p><h3>Would removing a few samples change the decision?</h3></div>
          <div><p>For supported small two-group comparisons, check whether the decision can be proved unchanged across a specified set of sample removals. A confirmed change and an unresolved result are reported separately.</p><a class="sg-text-link" href="/docs/sciground-scope/#sample-removal">See the sample-removal conditions <span aria-hidden="true">↗</span></a></div>
        </aside>
        <div id="connect" class="sg-connect">
          <div><p class="sg-kicker">MCP + API</p><h3>Connect SciGround to the AI you work with.</h3><p>Use an MCP-compatible AI environment to confirm a design, run an analysis, and receive verification results. Use the API to integrate SciGround into a research tool or agent.</p></div>
          <div class="sg-connect-actions"><a class="sg-button" href="/docs/sciground-connect/#mcp">MCP connection guide <span aria-hidden="true">↗</span></a><a class="sg-text-link" href="/docs/sciground-connect/#api">API integration guide <span aria-hidden="true">↗</span></a></div>
        </div>
      </div>
    </section>

    <section id="evidence" class="sg-section sg-evidence" aria-labelledby="evidence-title">
      <div class="sg-container">
        <div class="sg-section-head"><p class="sg-kicker">03 / Research in the open</p><h2 id="evidence-title">Examine the work<br />behind the technology.</h2><p class="sg-lead">Reliable numerical calculations. Verification of AI-generated results. Reproducible findings in statistical software. Licklider publishes the methods and evidence behind this work.</p></div>
        <div class="sg-subhead"><h3>Research papers</h3><a class="sg-text-link" href="/research/">All research <span aria-hidden="true">↗</span></a></div>
        <div class="sg-paper-grid">
          {papers.map((paper, index) => <article>
            <div class="sg-paper-top"><span>Research / Publication</span><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span></div>
            <h4><a href={paper.href}>{paper.title.replace(/ — preprint v[\d.]+$/, '')}</a></h4>
            <p>{paper.summary}</p><p class="sg-paper-status">{paper.status}</p>
            <div class="sg-paper-bottom"><time datetime={paper.sortKey}>{paper.date}</time><a href={paper.href}>Read the paper <span aria-hidden="true">↗</span></a></div>
          </article>)}
        </div>
        <div class="sg-upstream-head"><div><p class="sg-kicker">Upstream reports</p><h3>Improving the software research relies on.</h3><p>We investigate conditions that cause statistical software to lose or miscalculate results, and report reproducible findings to its developers.</p></div><p class="sg-upstream-count"><strong>{UPSTREAM_CONTRIBUTIONS.length}</strong> reports submitted<br /><strong>{upstreamFixCount}</strong> fixes merged upstream</p></div>
      </div>
      <div class="upstream-carousel sg-carousel" role="region" aria-label="Upstream reports">
        <div class="upstream-track">
          {[false, true].map((duplicate) => <div class="upstream-grid" aria-hidden={duplicate ? 'true' : undefined}>
            {UPSTREAM_CONTRIBUTIONS.map((item) => <article class="sg-report">
              <p class="sg-kicker">{item.project}</p><h4>{item.title}</h4><p class="panel-status">{item.panelStatus}</p>
              <p class="comparison-label">{item.comparisonLabel}</p><p class="sg-report-values"><span>{item.observed}</span><span aria-hidden="true">→</span><strong>{item.reference}</strong></p>
              <a href={item.href} tabindex={duplicate ? -1 : undefined}>Read the report <span aria-hidden="true">↗</span></a>
            </article>)}
          </div>)}
        </div>
      </div>
      <div class="sg-container"><p class="sg-fine sg-evidence-note">Each publication establishes findings within its studied conditions. Earlier work retains the nomue name and its original scope. For SciGround’s verification boundaries, see the <a href="/docs/sciground-scope/">product documentation</a>. <a href="/engineering/#upstream-status">How to read upstream outcomes</a>.</p>
        <details class="sg-latest"><summary>Latest research and engineering updates <span>View the latest eight</span></summary><ol>{latest.map((row) => <li><time datetime={row.sortKey}>{row.date}</time><a href={row.href}>{row.title}</a><span>{row.category}</span></li>)}</ol><a class="sg-text-link" href="/latest/">All updates <span aria-hidden="true">↗</span></a></details>
      </div>
    </section>

    <section id="faq" class="sg-section sg-faq" aria-labelledby="faq-title"><div class="sg-container sg-faq-layout"><div><p class="sg-kicker">04 / Before you begin</p><h2 id="faq-title">A few things<br />worth knowing.</h2></div><div class="sg-faq-list">{SCIGROUND_FAQ.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></div></section>

    <section class="sg-final" aria-labelledby="final-title"><div class="sg-container"><p class="sg-kicker">SciGround / From Design to Claim</p><h2 id="final-title">Give your research<br />a basis you can check.</h2><p>Start with a design, your data, or an existing analysis.<br />Establish what the evidence supports.</p><div class="sg-actions"><a class="sg-button" href="/docs/sciground-connect/">See how to connect <span aria-hidden="true">↗</span></a><a class="sg-text-link" href="/docs/sciground-scope/">Check your research fit <span aria-hidden="true">↗</span></a></div></div></section>
  </div>
</BaseLayout>
