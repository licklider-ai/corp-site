---
import { PUBLICATIONS } from '../data/publications';
import {
  EVALUATION_BOUNDARY,
  MARKET_SCOPE,
  PAIRED_T_BOUNDARY,
  PLATFORM_SCOPE,
  PRODUCT_CAPABILITY,
  PRODUCT_RELEASE_BOUNDARY,
  PUBLIC_CAPABILITY,
  PUBLIC_EVIDENCE,
  VERIFICATION_CALL_DEFINITION,
} from '../data/site-facts';
import BaseLayout from '../layouts/BaseLayout.astro';

const latest = [...PUBLICATIONS]
  .sort((a, b) => b.sortKey.localeCompare(a.sortKey))
  .slice(0, 8);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Licklider</p>
      <h1>The verification layer<br />for AI research agents</h1>
      <div class="lede">
        <p>
          Today, anyone can run the open-source nomue verifier locally to check a
          supported Welch Record, recompute covered quantities, and receive a
          machine-readable verification report.
        </p>
        <p>
          Licklider builds middleware for bounded verification calls across AI
          research—so research agents can send correctness-critical work to a separate,
          inspectable capability.
        </p>
      </div>
      <div class="cta">
        <a class="cta-primary" href="/docs/record-verification/">Run the verifier →</a>
        <a href="/docs/examples/">See examples →</a>
        <a href="/nomue/">How nomue works →</a>
      </div>
    </div>
  </section>

  <div class="sections">
    <section class="band band--single available-band">
      <div class="band-inner band-inner--wide">
        <p class="eyebrow">Available Now</p>
        <h2 class="available-title">Verify a supported Welch Record locally</h2>
        <p class="available-copy">{PUBLIC_CAPABILITY}</p>
        <div class="capability-grid">
          <article>
            <p class="step">1 · Check the contract</p>
            <h3>Confirm the exact supported procedure</h3>
            <p>Match the Record to the registered Release 1 bundle and Welch scope.</p>
          </article>
          <article>
            <p class="step">2 · Recompute</p>
            <h3>Check the covered numbers</h3>
            <p>Recompute registered quantities and compare them under the versioned rule.</p>
          </article>
          <article>
            <p class="step">3 · Return evidence</p>
            <h3>Produce a machine-readable report</h3>
            <p>Give the research agent scoped results, versions, and an actionable outcome.</p>
          </article>
        </div>
        <p class="more"><a href="/docs/record-verification/">→ Install and run locally</a> · <a href="/docs/examples.json">Machine-readable examples →</a></p>
      </div>
    </section>

    <section class="band">
      <p class="eyebrow">The Missing Call</p>
      <div class="band-body">
        <p class="lead">Generation has interfaces. Verification needs one too.</p>
        <p>
          A research agent can already call a literature search, a code runner, or a
          statistical library. But a calculation completing is not the same as knowing
          whether the design is supported, whether a required scientific fact is
          missing, whether a reported number agrees with a registered calculation, or
          whether the system should stop.
        </p>
        <p>
          Licklider builds the specialist layer that general research agents can call
          when a bounded part of the work needs separate verification.
        </p>
      </div>
    </section>

    <section class="band band--single">
      <div class="band-inner band-inner--wide">
        <p class="eyebrow">Verification Call</p>
        <p class="definition">{VERIFICATION_CALL_DEFINITION}</p>
        <div class="call-grid">
          <article>
            <p class="step">1 · Request</p>
            <h2>Send one bounded check</h2>
            <p>
              The call identifies the capability, version, evidence, and scientific
              declarations needed for the check.
            </p>
          </article>
          <article>
            <p class="step">2 · Decision</p>
            <h2>Get an actionable decision</h2>
            <p>
              The capability can proceed, ask for missing meaning, report unsupported
              scope, refuse safely, or preserve a failed check.
            </p>
          </article>
          <article>
            <p class="step">3 · Evidence</p>
            <h2>Preserve a checkable record</h2>
            <p>
              The result travels with what passed or failed, the evidence and versions
              used, the next action, and the exact boundary of the check.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="band band--single">
      <div class="band-inner band-inner--wide">
        <p class="eyebrow">Platform Scope</p>
        <div class="scope-grid">
          <article>
            <p class="scope-label">Available now</p>
            <h2>Local verification for Welch Records</h2>
            <p>{PUBLIC_CAPABILITY}</p>
            <p><a href="/docs/record-verification/">Run the verifier →</a></p>
          </article>
          <article>
            <p class="scope-label">Built in product</p>
            <h2>Welch verification for agent workflows</h2>
            <p>{PRODUCT_CAPABILITY}</p>
            <p class="availability-note">{PRODUCT_RELEASE_BOUNDARY}</p>
          </article>
          <article>
            <p class="scope-label">Platform</p>
            <h2>Verification calls across AI research</h2>
            <p>{PLATFORM_SCOPE}</p>
          </article>
        </div>
        <p class="roadmap-note"><strong>Next capability:</strong> {PAIRED_T_BOUNDARY}</p>
        <p class="scope-note">
          {MARKET_SCOPE}
        </p>
        <p class="scope-note">
          The business is designed as shared infrastructure between research agents and
          the evidence they rely on, not as a single all-purpose research workflow.
        </p>
      </div>
    </section>

    <section class="band band--single">
      <div class="band-inner">
        <p class="eyebrow">Agent-readable by Design</p>
        <div class="band-body band-body--wide">
          <h2 class="section-title">One underlying contract, two readers</h2>
          <p class="lead">
            Research agents and researchers should be able to inspect the same scope,
            required declarations, possible outcomes, and limits.
          </p>
          <p>
            Licklider publishes small discovery indexes, clean Markdown pages, explicit
            when-to-use and when-not-to-use guidance, and machine-readable examples. The
            purpose is not to make a model sound confident. It is to reduce wrong calls,
            prevent silent inference, and make the basis of a result easier for a
            researcher to review.
          </p>
          <div class="reader-grid">
            <article>
              <h3>For the research agent</h3>
              <p>Discover the right capability, provide the right facts, and stop at the stated boundary.</p>
            </article>
            <article>
              <h3>For the researcher</h3>
              <p>See what the agent asked, what was checked, and what still requires human judgment.</p>
            </article>
          </div>
          <p class="more">
            <a href="/docs/">→ Read the docs</a> · <a href="/llms.txt">llms.txt →</a>
          </p>
        </div>
      </div>
    </section>

    <section class="band band--single">
      <div class="band-inner band-inner--wide">
        <p class="eyebrow">What We Build</p>
        <div class="layers">
          <article>
            <p class="layer-label">Public trust layer</p>
            <h2>Protocol, Record, verifier</h2>
            <p>
              The public Protocol defines how supported evidence and scoped verification
              results are represented. A local verifier lets third parties check covered
              properties without depending on Licklider's service.
            </p>
          </article>
          <article>
            <p class="layer-label">Product layer</p>
            <h2>Agent-callable verification capabilities</h2>
            <p>
              nomue handles product-side intake, clarification, supported-scope
              decisions, deterministic execution, failure handling, and machine-readable
              next actions without turning private implementation choices into public
              Protocol requirements.
            </p>
          </article>
        </div>
        <p class="more"><a href="/nomue/">→ How nomue works</a></p>
      </div>
    </section>

    <section class="band band--single">
      <div class="band-inner band-inner--wide">
        <p class="eyebrow">Evidence Before Expansion</p>
        <div class="evidence-intro">
          <p class="lead">
            Verification infrastructure is credible only if small numerical differences
            and uncertain boundaries are treated as substantive engineering work.
          </p>
          <p>
            We investigate edge cases, check results against independent calculations,
            report defects upstream, and keep our diagnosis separate from a maintainer's
            confirmation. The work is useful to the wider scientific software ecosystem,
            whether or not it becomes a nomue capability.
          </p>
        </div>
        <div class="evidence-grid">
          {
            PUBLIC_EVIDENCE.map((item) => (
              <article>
                <p class="evidence-status">{item.status}</p>
                <h2><a href={item.href}>{item.title}</a></h2>
                <p>{item.summary}</p>
              </article>
            ))
          }
        </div>
        <p class="more"><a href="/engineering/">→ Engineering</a> · <a href="/research/">Research →</a></p>
      </div>
    </section>

    <section class="band">
      <p class="eyebrow">Evaluation</p>
      <div class="band-body">
        <p class="lead">Does adding nomue actually improve a research agent?</p>
        <p>
          We are building a controlled comparison of the same model and baseline tools,
          with and without nomue. The model is not allowed to judge whether its own
          answer is correct, and clarification, refusal, and unsupported scope are
          scored separately from numerical answers.
        </p>
        <p>{EVALUATION_BOUNDARY}</p>
        <p class="more"><a href="/evaluation/">→ Evaluation design and status</a></p>
      </div>
    </section>

    <section class="band">
      <p class="eyebrow">Thesis</p>
      <div class="band-body">
        <h2 class="section-title">Approval needs a checkable basis</h2>
        <p>
          AI has scaled generation. As more intellectual work is produced by machines,
          approval remains meaningful only when it stays connected to evidence that can
          be checked.
        </p>
        <p>
          We are not trying to automate responsibility. We are building the verification
          infrastructure that lets researchers exercise judgment with a clearer basis.
        </p>
        <p class="more"><a href="/thesis/">→ Read the thesis</a></p>
      </div>
    </section>

    <section id="latest" class="band">
      <p class="eyebrow">Latest</p>
      <div class="band-body latest-body">
        <div class="table-scroll">
          <table>
            <tbody>
              {
                latest.map((row) => (
                  <tr>
                    <td class="latest-date">{row.date}</td>
                    <td><a href={row.href}>{row.title}</a></td>
                    <td class="latest-category">
                      <a href={`/${row.category.toLowerCase()}/`}>{row.category}</a>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="more"><a href="/latest/">→ All updates</a></p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero { border-bottom: 1px solid var(--rule-faint); }
  .hero-inner { max-width: var(--shell); margin: 0 auto; padding: 7rem var(--gutter) 6rem; }
  .hero h1 { max-width: 61rem; margin: 1.25rem 0 2.5rem; font-size: clamp(2.7rem, 6vw, 4.45rem); line-height: 1.1; letter-spacing: -0.015em; }
  .lede { max-width: 45rem; font-size: 1.15rem; color: var(--ink-1); }
  .cta { display: flex; gap: 2rem; flex-wrap: wrap; margin-top: 3rem; font-size: 0.95rem; }
  .cta a { padding-bottom: 3px; border-bottom: 1px solid var(--ink); text-decoration: none; }
  .cta .cta-primary { padding: 0.65rem 0.9rem; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); }
  .sections { max-width: var(--shell); margin: 0 auto; padding: 0 var(--gutter); }
  .band { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 3rem; padding: 4rem 0; border-bottom: 1px solid var(--rule-faint); }
  .band:last-child { border-bottom: 0; }
  .band > .eyebrow { margin: 0.35rem 0 0; }
  .band--single { display: block; }
  .band-inner { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 3rem; }
  .band-inner > .eyebrow { margin: 0.35rem 0 0; }
  .band-inner--wide { display: block; }
  .band-inner--wide > .eyebrow { margin-bottom: 2rem; }
  .band-body { max-width: var(--measure); }
  .band-body--wide { max-width: 46rem; }
  .band-body > :last-child, article > :last-child { margin-bottom: 0; }
  .lead { color: var(--ink); font-size: 1.15rem; }
  .available-band { padding-top: 4.5rem; }
  .available-title { max-width: 48rem; margin: 0 0 1rem; font-size: clamp(1.8rem, 3.8vw, 2.8rem); line-height: 1.2; letter-spacing: -0.01em; }
  .available-copy { max-width: 48rem; margin-bottom: 2.25rem; color: var(--ink-1); font-size: 1.08rem; }
  .definition { max-width: 52rem; margin: 0 0 2.5rem; color: var(--ink); font-size: clamp(1.35rem, 2.8vw, 2rem); line-height: 1.45; }
  .capability-grid, .call-grid, .scope-grid, .evidence-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .capability-grid article, .call-grid article, .scope-grid article, .evidence-grid article { padding: 1.5rem; border: 1px solid var(--rule); }
  .capability-grid h3, .call-grid h2, .scope-grid h2, .evidence-grid h2, .layers h2 { margin-bottom: 0.75rem; font-size: 1.08rem; }
  .step, .scope-label, .layer-label, .evidence-status { margin-bottom: 0.55rem; color: var(--ink-3); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .scope-grid article:first-child { background: var(--wash); }
  .availability-note { padding-top: 0.75rem; border-top: 1px solid var(--rule-faint); color: var(--ink-3); font-size: 0.85rem; }
  .roadmap-note { max-width: 50rem; margin: 1.5rem 0 0; font-size: 0.9rem; color: var(--ink-2); }
  .scope-note { max-width: 47rem; margin: 2rem 0 0; padding-left: 1.25rem; border-left: 1px solid var(--ink); }
  .section-title { margin-bottom: 1rem; font-size: 1.3rem; }
  .reader-grid, .layers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; }
  .reader-grid article, .layers article { padding: 1.5rem; border: 1px solid var(--rule); }
  .reader-grid h3 { margin-bottom: 0.65rem; font-size: 1rem; }
  .evidence-intro { max-width: 45rem; margin-bottom: 2rem; }
  .evidence-grid h2 a { text-decoration: none; }
  .more { margin: 2rem 0 0; font-size: 0.92rem; }
  .table-scroll { overflow-x: auto; }
  .latest-body { max-width: none; }
  .latest-date { width: 10rem; white-space: nowrap; color: var(--ink-3); }
  .latest-category { width: 7rem; white-space: nowrap; text-align: right; }
  .latest-category a { color: var(--ink-3); text-decoration: none; }

  @media (max-width: 900px) {
    .hero-inner { padding: 4.5rem var(--gutter) 4rem; }
    .band, .band-inner { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .capability-grid, .call-grid, .scope-grid, .evidence-grid { grid-template-columns: minmax(0, 1fr); }
    .latest-date { width: 8rem; }
  }

  @media (max-width: 620px) {
    .reader-grid, .layers { grid-template-columns: minmax(0, 1fr); }
    .latest-category { display: none; }
  }
</style>
