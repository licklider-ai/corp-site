---
import ProtocolResearchProgress from '../components/ProtocolResearchProgress.astro';
import LickliderPortrait from '../components/LickliderPortrait.astro';
import {
  COMPANY_POSITION,
  MARKET_SCOPE,
  METHOD_IDENTITY_FINDING,
  PLATFORM_SCOPE,
  PRODUCT_RELEASE_BOUNDARY,
  PUBLIC_CAPABILITY,
  ROADMAP_POSITION,
  UPSTREAM_CONTRIBUTIONS,
  VERIFICATION_WORKING_METHOD,
} from '../data/site-facts';
import BaseLayout from '../layouts/BaseLayout.astro';

const company = [
  { term: 'Company', detail: 'Licklider, Inc.' },
  { term: 'Founder and CEO', detail: 'Tasuku Kobayashi' },
  { term: 'Headquarters', detail: 'N&E BLD. 7F, 1-12-4 Ginza, Chuo-ku, Tokyo, Japan' },
  { term: 'Founded', detail: 'July 2024' },
];
const mergedUpstreamFixes = UPSTREAM_CONTRIBUTIONS.filter(
  (item) => item.outcome === 'fix_merged',
);
const founderSelectedWork = [
  {
    category: 'Research',
    title: 'Correctly Rounded or Refused — preprint v0.2',
    status: 'Sole-author preprint · not peer reviewed',
    href: '/research/correctly-rounded-or-refused/',
    evidenceHref: 'https://zenodo.org/records/22025200',
    evidenceLabel: 'Zenodo record 22025200',
  },
  ...UPSTREAM_CONTRIBUTIONS.map((item) => ({
    category: item.project,
    title: item.title,
    status: `Reported by Tasuku Kobayashi · ${item.status}`,
    href: item.href,
    evidenceHref: item.evidenceHref,
    evidenceLabel: item.evidenceLabel,
  })),
];
const founderStructuredData = {
  '@type': 'Person',
  '@id': new URL('/about/#tasuku-kobayashi', Astro.site).href,
  name: 'Tasuku Kobayashi',
  jobTitle: 'Founder and CEO',
  description:
    'Founder and CEO of Licklider, serial entrepreneur, researcher, and contributor of numerical defect reports to scientific open-source software.',
  alumniOf: { '@type': 'Organization', name: 'Recruit' },
  worksFor: { '@id': new URL('/#organization', Astro.site).href },
};
---

<BaseLayout title="About" structuredData={founderStructuredData}>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">About</p>
      <h1>Infrastructure for the verification side of AI research</h1>
      <p class="standfirst">{COMPANY_POSITION}</p>
    </div>
  </section>

  <div class="sections">
    <section class="band">
      <p class="eyebrow">Available Today</p>
      <div class="band-body">
        <p class="lead">A public Protocol and a local verifier that anyone can inspect and run.</p>
        <p>{PUBLIC_CAPABILITY}</p>
        <p>Agents can also call the public local MCP release candidate to verify the same Release 1 Records. Verification runs locally after installation, without a Licklider account or hosted service.</p>
        <p><a href="/docs/mcp-verification/">Connect through MCP</a> · <a href="/docs/record-verification/">Run the verifier</a> · <a href="/nomue/">How nomue works</a></p>
      </div>
    </section>

    <section class="band">
      <p class="eyebrow">What We Do</p>
      <div class="band-body">
        <p>
          Research agents can generate analyses, code, figures, and scientific prose.
          Licklider works on the separate moment when a workflow needs to check one
          clearly defined part of that work against evidence.
        </p>
        <p>
          Our first product, nomue, begins with statistical verification. Its public
          verifier checks supported Records and returns machine-readable results.
        </p>
        <p>{PRODUCT_RELEASE_BOUNDARY}</p>
      </div>
    </section>

    <section class="band">
      <p class="eyebrow">Platform</p>
      <div class="band-body">
        <p class="lead">{ROADMAP_POSITION}</p>
        <p>{PLATFORM_SCOPE}</p>
        <p>{MARKET_SCOPE}</p>
        <p>
          Licklider sits between research agents and the evidence they rely on. The same
          verification layer can serve different agents and research workflows without
          replacing the general-purpose interface each researcher chooses.
        </p>
        <p>
          We expand the platform one evidenced capability at a time, so each new method
          has an explicit contract and an independently checkable basis.
        </p>
        <p><a href="/roadmap/">Product and capability roadmap</a></p>
      </div>
    </section>

    <section class="band band--wide">
      <p class="eyebrow">Research Progress</p>
      <div>
        <h2>Building the evidence for broader verification</h2>
        <p class="lead">Method expansion needs both a precise scientific guarantee and a calculation whose behavior can be checked.</p>
        <ProtocolResearchProgress />
        <p>These results demonstrate how we develop those foundations: inspect original sources, compare calculations with exact references, and repair claims when review finds a gap. The Release 4 proposal is now open for public discussion. These research, candidate, and discussion milestones remain separate from the public Release 1 Welch capability.</p>
      </div>
    </section>

    <section class="band">
      <p class="eyebrow">Shared Language</p>
      <div class="band-body">
        <p>
          Verification is useful only when people and machines can tell what a result
          means. We publish clear distinctions between execution, clarification,
          unsupported scope, refusal, failed checks, and properties that were not
          asserted.
        </p>
        <p><strong>{METHOD_IDENTITY_FINDING}</strong></p>
        <p>
          The purpose is practical: help a research agent avoid silent assumptions and
          help a researcher see the exact basis and limit of an AI-assisted result. We
          publish it as shared working language, not as a claim of ownership over how
          researchers speak.
        </p>
        <p><a href="/docs/decision-vocabulary/">Decision vocabulary</a></p>
      </div>
    </section>

    <section class="band band--wide">
      <p class="eyebrow">How We Work</p>
      <div class="work-body">
        <div class="work-copy">
          <p>
            Precision is part of the product. We investigate very small numerical
            disagreements, build independent checks, define exact claim boundaries, and
            keep our diagnosis separate from an upstream maintainer's confirmation.
          </p>
          <p>{VERIFICATION_WORKING_METHOD}</p>
          <p>
            When that work finds a defect in scientific software, we report it back to
            the project. The contribution matters even when the finding never becomes a
            nomue capability.
          </p>
          <p>
            Our current public record contains {UPSTREAM_CONTRIBUTIONS.length} upstream
            reports and {mergedUpstreamFixes.length} merged fixes. Each result
            links to the external issue, review, or commit. This is public evidence of
            the verification engineering behind the platform, rather than the limit of
            what Licklider intends to build.
          </p>
        </div>
        <div class="evidence-list">
          {
            mergedUpstreamFixes.map((item) => (
              <article>
                <p class="evidence-status">{item.project} · {item.status}</p>
                <h2><a href={item.href}>{item.title}</a></h2>
                <p>{item.summary}</p>
                <p><a href={item.evidenceHref} target="_blank" rel="noopener noreferrer">{item.evidenceLabel}</a></p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="band band--wide">
      <p class="eyebrow">Why “Licklider”</p>
      <div class="why">
        <div class="band-body">
          <p>
            In “Man-Computer Symbiosis” (1960), J. C. R. Licklider described a division
            of labor in which humans set goals and exercise judgment while computers
            carry out routine work.
          </p>
          <p>
            As machines take on more generation and execution, researchers become more
            important, not less. Their judgment needs clearer evidence and better
            boundaries. Our name refers to that original vision of complementary roles.
          </p>
        </div>
        <LickliderPortrait />
      </div>
    </section>

    <section id="tasuku-kobayashi" class="band band--wide">
      <p class="eyebrow">Founder</p>
      <div class="founder-profile">
        <h2>Tasuku Kobayashi</h2>
        <p class="founder-role">Founder and CEO</p>
        <div class="founder-copy">
          <p>
            Tasuku Kobayashi is a serial entrepreneur and the Founder &amp; CEO of
            Licklider Inc.
          </p>
          <p>
            After leading a business unit at Recruit, one of Japan's largest tech
            companies and the parent organization of Indeed and Glassdoor, he launched a
            veterinary medicine startup and founded an AI enterprise, which he exited via
            M&amp;A. His career has centered on scaling businesses in heavily regulated
            domains, where trust is a foundational requirement.
          </p>
          <p>
            Leveraging that expertise, he founded Licklider to establish the de facto
            standard for a "Verification Layer"—the key to the safe, compliant, and
            reliable deployment of generative AI in regulated industries, starting with
            life sciences research, where precision is non-negotiable. His core
            hypothesis: a verification layer is what users need before they can operate
            LLMs with confidence, and it will let researchers use AI to dramatically
            accelerate their intellectual output.
          </p>
          <p>
            By building an environment where researchers can work with peace of mind,
            Licklider aims to unlock the next wave of breakthrough inventions that
            transform the world—serving as the essential engine behind the scenes that
            advances global health, safety, and cultural prosperity.
          </p>
        </div>

        <h3>Selected work</h3>
        <div class="founder-work">
          {
            founderSelectedWork.map((item) => (
              <article>
                <p class="evidence-status">{item.category} · {item.status}</p>
                <h4><a href={item.href}>{item.title}</a></h4>
                <p>
                  <a href={item.evidenceHref} target="_blank" rel="noopener noreferrer">
                    {item.evidenceLabel}
                  </a>
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="band">
      <p class="eyebrow">Company</p>
      <div class="band-body">
        <dl class="company">
          {
            company.map((row) => (
              <>
                <dt>{row.term}</dt>
                <dd>{row.detail}</dd>
              </>
            ))
          }
        </dl>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Keep the 40% media column without letting a tall SVG dictate section height. */
  .why :global(.portrait) {
    width: 100%;
    min-width: 0;
    margin: 0;
  }

  .why :global(.portrait svg) {
    width: 100%;
    height: auto;
    max-height: 18rem;
    object-fit: contain;
  }

@layer legacy {

  .page-hero { border-bottom: 1px solid var(--rule-faint); }
  .page-hero-inner { max-width: var(--shell); margin: 0 auto; padding: 5.5rem var(--gutter) 4.5rem; }
  .page-hero h1 { margin: 1.1rem 0 1.75rem; font-size: clamp(2.2rem, 4.8vw, 3.4rem); line-height: 1.2; letter-spacing: -0.01em; }
  .standfirst { max-width: var(--measure); margin: 0; font-size: 1.08rem; color: var(--ink-2); }
  .sections { max-width: var(--shell); margin: 0 auto; padding: 0 var(--gutter); }
  .band { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 3rem; padding: 4rem 0; border-bottom: 1px solid var(--rule-faint); }
  .band:last-child { border-bottom: 0; }
  .band > .eyebrow { margin: 0.35rem 0 0; }
  .band-body { max-width: var(--measure); }
  .band-body > :last-child, article > :last-child { margin-bottom: 0; }
  .lead { color: var(--ink); font-size: 1.15rem; }
  .work-body { max-width: 52rem; }
  .work-copy { max-width: var(--measure); }
  .evidence-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; }
  .evidence-list article { padding: 1.25rem; border: 1px solid var(--rule); }
  .evidence-list h2 { margin-bottom: 0.65rem; font-size: 1.02rem; }
  .evidence-status { margin-bottom: 0.5rem; color: var(--ink-3); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .why { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 4rem; align-items: start; }
  .founder-profile h2 { margin-bottom: 0.35rem; font-size: 1.25rem; }
  .founder-role { margin-bottom: 1rem; color: var(--ink-3); font-size: 0.85rem; }
  .founder-copy { max-width: var(--measure); }
  .founder-profile h3 { margin: 2.5rem 0 1rem; font-size: 1rem; }
  .founder-work { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .founder-work article { padding: 1.25rem; border: 1px solid var(--rule); }
  .founder-work h4 { margin: 0 0 0.65rem; font-size: 1rem; line-height: 1.35; }
  .company { display: grid; grid-template-columns: 9rem minmax(0, 1fr); row-gap: 0.5rem; margin: 0; font-size: 0.95rem; }
  .company dt { padding-top: 0.15rem; color: var(--ink-3); font-size: 0.85rem; }
  .company dd { margin: 0; }

  @media (max-width: 800px) {
    .page-hero-inner { padding: 3.5rem var(--gutter) 3rem; }
    .band { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; padding: 3rem 0; }
    .why { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .company { grid-template-columns: 7.5rem minmax(0, 1fr); }
  }

  @media (max-width: 620px) {
    .evidence-list, .founder-work { grid-template-columns: minmax(0, 1fr); }
  }

}
</style>
