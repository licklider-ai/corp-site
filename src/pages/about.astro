---
import BaseLayout from '../layouts/BaseLayout.astro';

const company = [
  { term: 'Company', detail: 'Licklider, Inc.' },
  { term: 'Headquarters', detail: 'N&E BLD. 7F, 1-12-4 Ginza, Chuo-ku, Tokyo, Japan' },
  { term: 'Founded', detail: 'July 2024' },
];
---

<BaseLayout
  title="About"
  description="Licklider builds scientific verification infrastructure for AI research agents, starting with statistics."
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">About</p>
      <h1>About Licklider</h1>
      <p class="standfirst">
        Licklider is an infrastructure company in Tokyo. We build scientific verification for AI research agents, starting with statistics.
      </p>
    </div>
  </section>

  <div class="sections">
    <section class="band">
      <p class="eyebrow">What We Do</p>
      <div class="band-body">
        <p>
          Our first product, nomue, gives research agents a separate place to check bounded statistical decisions and numerical results rather than relying on the model to judge its own analysis.
        </p>
        <p>
          We combine product engineering with research, public specifications, independent verification, and controlled evaluation. The current public Protocol begins with a deliberately narrow Welch t-test scope and expands only through explicit evidence and review.
        </p>
      </div>
    </section>

    <section class="band">
      <p class="eyebrow">Mission</p>
      <div class="band-body">
        <p>
          Our broader mission is to make responsible approval possible at machine scale. AI can generate analyses, figures, prose, and code faster than people can verify them. The work that remains human — deciding what to accept and what to take responsibility for — needs infrastructure of its own.
        </p>
        <p>
          We call this engineering accountability: designing the conditions under which approval stays connected to evidence that can be checked.
        </p>
      </div>
    </section>

    <section class="band">
      <p class="eyebrow">Team</p>
      <div class="band-body">
        <p>
          Licklider was founded in Tokyo and works with researchers wherever they work. We treat software engineering and scientific verification as one discipline: claims should have explicit scope, important boundaries should be stated plainly, and supported results should be independently checkable where possible.
        </p>
      </div>
    </section>

    <section class="band">
      <p class="eyebrow">Company</p>
      <div class="band-body">
        <dl class="company">
          {
            company.map((row) => (
              <>
                <dt>{row.term}</dt>
                <dd>{row.detail}</dd>
              </>
            ))
          }
        </dl>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-hero {
    border-bottom: 1px solid var(--rule-faint);
  }

  .page-hero-inner {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 5.5rem var(--gutter) 4.5rem;
  }

  .page-hero h1 {
    font-size: clamp(2.2rem, 4.8vw, 3.4rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 1.1rem 0 1.75rem;
  }

  .standfirst {
    margin: 0;
    max-width: var(--measure);
    font-size: 1.08rem;
    color: var(--ink-2);
  }

  .sections {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .band {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 3rem;
    padding: 4rem 0;
    border-bottom: 1px solid var(--rule-faint);
  }

  .band:last-child {
    border-bottom: 0;
  }

  .band > .eyebrow {
    margin: 0.35rem 0 0;
  }

  .band-body {
    max-width: var(--measure);
  }

  .band-body > :last-child {
    margin-bottom: 0;
  }

  .company {
    margin: 0;
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    row-gap: 0.5rem;
    font-size: 0.95rem;
  }

  .company dt {
    color: var(--ink-3);
    font-size: 0.85rem;
    padding-top: 0.15rem;
  }

  .company dd {
    margin: 0;
  }

  @media (max-width: 800px) {
    .page-hero-inner {
      padding: 3.5rem var(--gutter) 3rem;
    }

    .band {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
      padding: 3rem 0;
    }

    .company {
      grid-template-columns: 7.5rem minmax(0, 1fr);
    }
  }
</style>
