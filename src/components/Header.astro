---
import { GLOBAL_NAV, SITE_TITLE } from '../consts';

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current === href.replace(/\/$/, '');
---

<header class="site-header">
  <div class="inner">
    <a class="logo" href="/">{SITE_TITLE}</a>

    <nav aria-label="グローバルナビゲーション">
      <ul>
        {
          GLOBAL_NAV.map((item) => (
            <li>
              {item.ready ? (
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ) : (
                <span class="placeholder" title="準備中">
                  {item.label}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }

  .inner {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 1.4rem var(--gutter);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
  }

  .logo {
    font-size: 1.4rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--ink);
  }

  .logo:hover {
    color: var(--ink-2);
  }

  nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  nav li {
    margin: 0;
  }

  nav a,
  nav span {
    font-size: 0.88rem;
    text-decoration: none;
    color: var(--ink-2);
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
  }

  @media (max-width: 700px) {
    .inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    nav ul {
      gap: 1.1rem;
    }
  }
</style>
