---
import { GLOBAL_NAV, SITE_TITLE } from '../consts';

const current = Astro.url.pathname;
const isActive = (href: string) => {
  if (href.includes('#')) return false;
  const base = href.replace(/\/$/, '');
  return current === href || current === base || current.startsWith(`${base}/`);
};
---

<header class="site-header">
  <div class="inner">
    <a class="logo" href="/">
      <span>{SITE_TITLE}</span>
      <img class="logo-mark" src="/favicon.svg" alt="" aria-hidden="true" />
    </a>

    <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="global-navigation" data-ui>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 8h16M4 16h16" /></svg>
    </button>
    <nav id="global-navigation" aria-label="Global navigation">
      <ul>
        {
          GLOBAL_NAV.map((item) => (
            <li>
              {item.ready ? (
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ) : (
                <span class="placeholder" title="Coming soon">
                  {item.label}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // 固定ヘッダーの実寸を --header-h に反映する。追従するメニューの開始位置と、
  // アンカーで飛んだときの見出し位置を、ヘッダーの下に揃えるために使う。
  const header = document.querySelector<HTMLElement>('.site-header');

  if (header) {
    const toggle = header.querySelector<HTMLButtonElement>('.nav-toggle');
    const nav = header.querySelector<HTMLElement>('#global-navigation');
    if (toggle && nav) {
      header.dataset.enhanced = '';
      const setOpen = (open: boolean) => {
        toggle.setAttribute('aria-expanded', String(open));
        nav.toggleAttribute('data-open', open);
      };
      toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
      header.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          toggle.focus();
        }
      });
      nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
      const mobile = window.matchMedia('(max-width: 800px)');
      mobile.addEventListener('change', () => {
        if (mobile.matches && nav.contains(document.activeElement)) toggle.focus();
        setOpen(false);
      });
    }
    const sync = () => {
      const height = header.offsetHeight;

      // ヘッダーが描画されていないときは 0 になる。CSS 側の既定値を潰さないよう無視する
      if (height > 0) {
        document.documentElement.style.setProperty('--header-h', `${height}px`);
      }
    };

    sync();
    new ResizeObserver(sync).observe(header);
  }
</script>

<style>
@layer legacy {

  /* 固定ヘッダー。高さは --header-h として下位のレイアウトから参照される */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }

  .inner {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 1.4rem var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.44em;
    font-size: 1.4rem;
    line-height: 1;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }

  .logo-mark {
    display: block;
    width: auto;
    height: 0.88em;
    flex: 0 0 auto;
    transform: translateY(-0.015em);
  }

  .logo:hover {
    color: var(--ink-2);
  }

  nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: nowrap;
    justify-content: flex-end;
  }

  nav li {
    margin: 0;
  }

  nav a,
  nav span {
    font-size: 0.88rem;
    text-decoration: none;
    color: var(--ink-2);
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
  }

  @media (max-width: 700px) {
    .inner {
      gap: 0.75rem;
      padding-block: 1rem;
      align-items: flex-start;
      flex-direction: column;
    }

    .logo {
      font-size: 1.15rem;
    }

    nav ul {
      gap: 0.85rem;
      flex-wrap: wrap;
      justify-content: flex-start;
    }

    nav a,
    nav span {
      font-size: 0.82rem;
      white-space: nowrap;
    }
  }

}
</style>
