---
import { GLOBAL_NAV, SITE_TITLE } from '../consts';

const current = Astro.url.pathname;
const isActive = (href: string) => {
  if (href.includes('#')) return false;
  const base = href.replace(/\/$/, '');
  return current === href || current === base || current.startsWith(`${base}/`);
};
---

<header class="site-header">
  <div class="inner">
    <a class="logo" href="/">{SITE_TITLE}</a>

    <nav aria-label="Global navigation">
      <ul>
        {
          GLOBAL_NAV.map((item) => (
            <li>
              {item.ready ? (
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ) : (
                <span class="placeholder" title="Coming soon">
                  {item.label}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // 固定ヘッダーの実寸を --header-h に反映する。追従するメニューの開始位置と、
  // アンカーで飛んだときの見出し位置を、ヘッダーの下に揃えるために使う。
  const header = document.querySelector<HTMLElement>('.site-header');

  if (header) {
    const sync = () => {
      const height = header.offsetHeight;

      // ヘッダーが描画されていないときは 0 になる。CSS 側の既定値を潰さないよう無視する
      if (height > 0) {
        document.documentElement.style.setProperty('--header-h', `${height}px`);
      }
    };

    sync();
    new ResizeObserver(sync).observe(header);
  }
</script>

<style>
  /* 固定ヘッダー。高さは --header-h として下位のレイアウトから参照される */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }

  .inner {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 1.4rem var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .logo {
    font-size: 1.4rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }

  .logo:hover {
    color: var(--ink-2);
  }

  nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: nowrap;
    justify-content: flex-end;
  }

  nav li {
    margin: 0;
  }

  nav a,
  nav span {
    font-size: 0.88rem;
    text-decoration: none;
    color: var(--ink-2);
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
  }

  @media (max-width: 700px) {
    .inner {
      gap: 0.75rem;
      padding-block: 1rem;
      align-items: flex-start;
      flex-direction: column;
    }

    .logo {
      font-size: 1.15rem;
    }

    nav ul {
      gap: 0.85rem;
      flex-wrap: wrap;
      justify-content: flex-start;
    }

    nav a,
    nav span {
      font-size: 0.82rem;
      white-space: nowrap;
    }
  }
</style>
