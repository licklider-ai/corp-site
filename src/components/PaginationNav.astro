---
interface Props {
  currentPage: number;
  lastPage: number;
  prev?: string;
  next?: string;
}

const { currentPage, lastPage, prev, next } = Astro.props;
---

<nav class="pagination" aria-label="Latest pages">
  <div class="pagination-link pagination-link--newer">
    {prev && <a href={prev} rel="prev">← Newer posts</a>}
  </div>
  <p>Page <strong>{currentPage}</strong> of {lastPage}</p>
  <div class="pagination-link pagination-link--older">
    {next && <a href={next} rel="next">Older posts →</a>}
  </div>
</nav>

<style>
@layer legacy {

  .pagination {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--rule);
  }

  .pagination p {
    margin: 0;
    color: var(--ink-3);
    font-size: 0.82rem;
  }

  .pagination strong {
    color: var(--ink);
    font-weight: 500;
  }

  .pagination-link {
    min-width: 0;
  }

  .pagination-link--older {
    text-align: right;
  }

  @media (max-width: 560px) {
    .pagination {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0.75rem 1rem;
    }

    .pagination p {
      grid-column: 1 / -1;
      grid-row: 1;
      text-align: center;
    }
  }

}
</style>
