---
interface Props {
  currentPage: number;
  lastPage: number;
  prev?: string;
  next?: string;
}

const { currentPage, lastPage, prev, next } = Astro.props;
const pageNumbers = Array.from({ length: lastPage }, (_, index) => index + 1);
const pageUrl = (pageNumber: number) =>
  pageNumber === 1 ? '/latest/' : `/latest/${pageNumber}/`;
---

<nav class="pagination" aria-label="Latest pages">
  <div class="pagination-link pagination-link--newer">
    {prev && (
      <a class="pagination-button" href={prev} rel="prev">
        <span aria-hidden="true">←</span>
        Newer posts
      </a>
    )}
  </div>
  <ol class="pagination-pages" aria-label="Page numbers">
    {pageNumbers.map((pageNumber) => (
      <li>
        <a
          href={pageUrl(pageNumber)}
          aria-label={`Page ${pageNumber}`}
          aria-current={pageNumber === currentPage ? 'page' : undefined}
        >
          {pageNumber}
        </a>
      </li>
    ))}
  </ol>
  <div class="pagination-link pagination-link--older">
    {next && (
      <a class="pagination-button" href={next} rel="next">
        Older posts
        <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</nav>

<style>
@layer design {

  .pagination {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: start;
    gap: 1.5rem;
    padding: 2.5rem 0 3.5rem;
    border-top: 1px solid var(--rule);
    font-size: 1rem;
  }

  .pagination-pages {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pagination-pages a {
    display: grid;
    min-width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }

  .pagination-pages li {
    margin: 0;
    padding: 0;
  }

  .pagination-pages a:hover,
  .pagination-pages a[aria-current='page'] {
    border-color: var(--ink);
    background: var(--wash);
  }

  .pagination-link {
    display: flex;
    align-items: flex-start;
    min-width: 0;
    height: 2.75rem;
  }

  .pagination .pagination-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 10.5rem;
    height: 100%;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--action);
    border-radius: 4px;
    background: var(--action);
    color: white;
    text-decoration: none;
  }

  .pagination .pagination-button:hover {
    border-color: var(--action-hover);
    background: var(--action-hover);
    color: white;
  }

  .pagination-link--older {
    justify-content: flex-end;
    text-align: right;
  }

  @media (max-width: 560px) {
    .pagination {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0.75rem 1rem;
    }

    .pagination-pages {
      grid-column: 1 / -1;
      grid-row: 1;
      justify-content: center;
    }

    .pagination .pagination-button {
      width: 100%;
      min-width: 0;
    }
  }

}

/* Keep button links independent from the site's layered inline-link styles. */
.pagination .pagination-button,
.pagination .pagination-button:visited,
.pagination .pagination-button:hover,
.pagination .pagination-button:focus-visible {
  color: #fff;
  text-decoration: none;
  text-decoration-color: transparent;
}
</style>
