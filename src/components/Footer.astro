---
import { SITE_UPDATED, SITE_VERSION } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <p class="note">
      このページは版管理されている。{SITE_VERSION} — {SITE_UPDATED}
    </p>

    <ul class="links">
      <li><span class="placeholder" title="準備中">nomue</span></li>
      <li><span class="placeholder" title="準備中">GitHub</span></li>
      <li>
        <a href="mailto:contact@licklider.ai">contact@licklider.ai</a>
      </li>
    </ul>

    <p class="copyright">
      © {year} Licklider, Inc. <span class="placeholder">[年表記要確認]</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: 6rem;
  }

  .inner {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 2.5rem var(--gutter) 4rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .note,
  .copyright {
    margin: 0;
    font-size: 0.82rem;
    color: var(--ink-3);
  }

  .links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0.25rem 0;
    padding: 0;
    font-size: 0.82rem;
  }

  .links li {
    margin: 0;
  }

  .links a,
  .links span {
    color: var(--ink-2);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
