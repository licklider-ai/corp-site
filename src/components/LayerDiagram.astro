---
// Layer 1 と Layer 2 の相互作用を示す等角図。
// 上段 = nomue（生成）、下段 = nomue Record と verifier（記録・検証）。
// 左列の矢印が下から上（根拠の供給）、右列が上から下（記録）を表す。

type Point = [number, number];

// 等角の基準寸法: 上面の菱形は半幅 w・半高 h、側面の厚みが t
const w = 150;
const h = 86;
const t = 40;
const cx = 230;
const topY = 110; // 上段の上面の中心
const bottomY = 330; // 下段の上面の中心
const corner = 12; // 角の丸み

const fmt = ([x, y]: Point) => `${x.toFixed(1)} ${y.toFixed(1)}`;

// 多角形の角を丸めたパスを作る。各頂点の手前で辺を切り、頂点を制御点にした曲線でつなぐ
const rounded = (points: Point[], radius: number) => {
  const n = points.length;
  const segments: string[] = [];

  const toward = (from: Point, to: Point): Point => {
    const dx = to[0] - from[0];
    const dy = to[1] - from[1];
    const length = Math.hypot(dx, dy);
    const r = Math.min(radius, length / 2);
    return [from[0] + (dx / length) * r, from[1] + (dy / length) * r];
  };

  for (let i = 0; i < n; i++) {
    const previous = points[(i - 1 + n) % n]!;
    const current = points[i]!;
    const next = points[(i + 1) % n]!;

    segments.push(`${i === 0 ? 'M' : 'L'}${fmt(toward(current, previous))}`);
    segments.push(`Q${fmt(current)} ${fmt(toward(current, next))}`);
  }

  return `${segments.join(' ')} Z`;
};

// 立体の外形 (六角形) と、上を向く面 (菱形)
const silhouette = (cy: number): Point[] => [
  [cx, cy - h],
  [cx + w, cy],
  [cx + w, cy + t],
  [cx, cy + h + t],
  [cx - w, cy + t],
  [cx - w, cy],
];

const topFace = (cy: number): Point[] => [
  [cx, cy - h],
  [cx + w, cy],
  [cx, cy + h],
  [cx - w, cy],
];

// 上面へ図形を投影する行列。平面座標 -100..100 の正方形が上面の菱形に重なる
// (u,v)=(100,-100) が右の角、(100,100) が手前の角に対応するため除数は 200
const project = (cy: number) => `matrix(${w / 200} ${h / 200} ${-w / 200} ${h / 200} ${cx} ${cy})`;

// Layer 2 の紋: 歯車 (アプリケーション)
const gear = (teeth: number, outer: number, inner: number) => {
  const step = (Math.PI * 2) / teeth;
  const tip = step * 0.26; // 歯先の半幅
  const base = step * 0.42; // 歯元の半幅
  const at = (radius: number, angle: number) =>
    fmt([radius * Math.cos(angle), radius * Math.sin(angle)]);

  const segments: string[] = [];
  for (let i = 0; i < teeth; i++) {
    const a = i * step;
    segments.push(`${i === 0 ? 'M' : 'L'}${at(inner, a - base)}`);
    segments.push(`L${at(outer, a - tip)}`);
    segments.push(`L${at(outer, a + tip)}`);
    segments.push(`L${at(inner, a + base)}`);
  }
  return `${segments.join(' ')} Z`;
};

const gearPath = gear(8, 60, 44);

// Layer 1 の紋: 盾と鍵穴 (記録の保全と検証)。
// 鍵穴は円と軸を一本のパスにして、内側に継ぎ目が出ないようにする
const shieldPath = 'M0 -64 L46 -42 C46 4 29 40 0 60 C-29 40 -46 4 -46 -42 Z';
const keyholePath = 'M-6.5 -0.7 A13 13 0 1 1 6.5 -0.7 L11 26 L-11 26 Z';

const chevronY = [200, 230, 260];

const notes = {
  left: [
    {
      title: '根拠の供給',
      body: '記録された入力データ、利用者の宣言、統計規則、計算が、生成の根拠になる',
    },
    {
      title: '独立した検証',
      body: 'verifier が Record の内部整合を、当社のソフトウェアに依存せず検証する',
    },
  ],
  right: [
    {
      title: '同一の根拠の上に生成',
      body: '解析、図、Legend、Methods、Results、Claim を Record の上に生成する',
    },
    {
      title: '無効化と再生成',
      body: 'データ・宣言・解析の変更が、影響を受ける成果物を無効化する',
    },
  ],
};
---

<figure class="interaction">
  <div class="notes notes--left">
    {
      notes.left.map((note) => (
        <div class="note">
          <p class="note-title">{note.title}</p>
          <p class="note-body">{note.body}</p>
        </div>
      ))
    }
  </div>

  <div class="stack">
    <p class="stack-label">Layer 2 — nomue（アプリケーション）</p>

    <svg viewBox="0 0 460 480" role="img" aria-labelledby="layer-diagram-title">
      <title id="layer-diagram-title">
        上段の nomue（生成）と下段の nomue Record・verifier（記録と検証）が、上下に往復する等角図
      </title>

      <!-- 軸 -->
      <line class="axis" x1={cx} y1="6" x2={cx} y2={topY - h} />
      <line class="axis" x1={cx} y1={bottomY + h + t} x2={cx} y2="474" />

      <!-- 二つの層をつなぐ垂線 -->
      <line class="link" x1={cx - w} y1={topY + t} x2={cx - w} y2={bottomY} />
      <line class="link" x1={cx + w} y1={topY + t} x2={cx + w} y2={bottomY} />
      <line class="link" x1={cx} y1={topY + h + t} x2={cx} y2={bottomY + h} />

      <!-- 下から上へ: 根拠の供給 -->
      <g class="flow">
        {
          chevronY.map((y, i) => (
            <path
              d={`M144 ${y + 8} L152 ${y} L160 ${y + 8}`}
              style={`animation-delay: ${(chevronY.length - 1 - i) * 0.22}s`}
            />
          ))
        }
      </g>

      <!-- 上から下へ: 記録 -->
      <g class="flow">
        {
          chevronY.map((y, i) => (
            <path
              d={`M300 ${y} L308 ${y + 8} L316 ${y}`}
              style={`animation-delay: ${i * 0.22}s`}
            />
          ))
        }
      </g>

      <!-- Layer 2 -->
      <g class="slab">
        <path class="body" d={rounded(silhouette(topY), corner)} />
        <line class="seam" x1={cx} y1={topY + h + 2} x2={cx} y2={topY + h + t - corner} />
        <path class="deck" d={rounded(topFace(topY), corner)} />
        <g class="mark" transform={project(topY)}>
          <path d={gearPath} vector-effect="non-scaling-stroke" />
          <circle cx="0" cy="0" r="20" vector-effect="non-scaling-stroke" />
        </g>
      </g>

      <!-- Layer 1 -->
      <g class="slab">
        <path class="body" d={rounded(silhouette(bottomY), corner)} />
        <line class="seam" x1={cx} y1={bottomY + h + 2} x2={cx} y2={bottomY + h + t - corner} />
        <path class="deck" d={rounded(topFace(bottomY), corner)} />
        <g class="mark" transform={project(bottomY)}>
          <path d={shieldPath} vector-effect="non-scaling-stroke" />
          <path d={keyholePath} vector-effect="non-scaling-stroke" />
        </g>
      </g>
    </svg>

    <p class="stack-label">Layer 1 — nomue Record ＋ verifier</p>
  </div>

  <div class="notes notes--right">
    {
      notes.right.map((note) => (
        <div class="note">
          <p class="note-title">{note.title}</p>
          <p class="note-body">{note.body}</p>
        </div>
      ))
    }
  </div>

  <figcaption class="placeholder">
    [図: Evidence →（宣言・規則・計算）→ Outputs。下層に Record（記録）と Verifier（第三者検証）を貫通させる層構造図]
  </figcaption>
</figure>

<style>
  .interaction {
    margin: 3.5rem 0 0;
    display: grid;
    /* 中央は明示的に幅を与える。auto だと SVG の既定サイズ (300px) で決まってしまう */
    grid-template-columns: minmax(0, 1fr) 26rem minmax(0, 1fr);
    align-items: center;
    gap: 2.5rem;
  }

  .stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .stack-label {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    text-align: center;
  }

  /* 外形は黒の枠線と薄いグレーの塗り。奥の線はこの塗りで隠れる */
  .body {
    fill: var(--wash-lo);
    stroke: var(--ink);
    stroke-width: 1.25;
  }

  .deck {
    fill: var(--wash-hi);
    stroke: var(--ink);
    stroke-width: 1.25;
  }

  .seam {
    stroke: var(--ink-4);
    stroke-width: 1;
  }

  .mark path,
  .mark circle {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.15;
    stroke-linejoin: round;
  }

  .axis {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .link {
    stroke: var(--ink-4);
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }

  .flow path {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: flow-pulse 3.2s ease-in-out infinite;
  }

  @keyframes flow-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    45% {
      opacity: 1;
    }
  }

  .notes {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .notes--left {
    text-align: right;
  }

  .note-title {
    margin: 0 0 0.4rem;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .note-body {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--ink-3);
  }

  figcaption {
    grid-column: 1 / -1;
    margin-top: 2.5rem;
    font-size: 0.8rem;
    line-height: 1.6;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .flow path {
      animation: none;
      opacity: 0.6;
    }
  }

  @media (max-width: 900px) {
    .interaction {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .stack {
      order: -1;
      max-width: 26rem;
      margin: 0 auto;
    }

    .notes--left {
      text-align: left;
    }

    .notes {
      gap: 2rem;
    }

    figcaption {
      text-align: left;
    }
  }
</style>
