---
// Layer 1 と Layer 2 の相互作用を示す等角図。
// 上段 = nomue（生成）、下段 = nomue Record と verifier（記録・検証）。
// 左列の矢印が下から上（根拠の供給）、右列が上から下（記録）を表す。

type Point = [number, number];

// 等角の基準寸法: 上面の菱形は半幅 w・半高 h、側面の厚みが t
const w = 150;
const h = 86;
const t = 40;
const cx = 230;
const topY = 110; // 上段の上面の中心
const bottomY = 330; // 下段の上面の中心
const corner = 4; // 角の丸み。輪郭がわずかに和らぐ程度に留める

const fmt = ([x, y]: Point) => `${x.toFixed(1)} ${y.toFixed(1)}`;

// from から to の向きに radius だけ進んだ点。角を丸めるための切り取り位置
const toward = (from: Point, to: Point, radius: number): Point => {
  const dx = to[0] - from[0];
  const dy = to[1] - from[1];
  const length = Math.hypot(dx, dy);
  const r = Math.min(radius, length / 2);
  return [from[0] + (dx / length) * r, from[1] + (dy / length) * r];
};

// 多角形の角を丸めたパスを作る。各頂点の手前で辺を切り、頂点を制御点にした曲線でつなぐ
const rounded = (points: Point[], radius: number) => {
  const n = points.length;
  const segments: string[] = [];

  for (let i = 0; i < n; i++) {
    const previous = points[(i - 1 + n) % n]!;
    const current = points[i]!;
    const next = points[(i + 1) % n]!;

    segments.push(`${i === 0 ? 'M' : 'L'}${fmt(toward(current, previous, radius))}`);
    segments.push(`Q${fmt(current)} ${fmt(toward(current, next, radius))}`);
  }

  return `${segments.join(' ')} Z`;
};

// 閉じない折れ線。両端はそのまま、途中の角だけ丸める
const roundedOpen = (points: Point[], radius: number) => {
  const segments: string[] = [`M${fmt(points[0]!)}`];

  for (let i = 1; i < points.length - 1; i++) {
    const current = points[i]!;
    segments.push(`L${fmt(toward(current, points[i - 1]!, radius))}`);
    segments.push(`Q${fmt(current)} ${fmt(toward(current, points[i + 1]!, radius))}`);
  }

  segments.push(`L${fmt(points[points.length - 1]!)}`);
  return segments.join(' ');
};

// 立体の外形 (六角形) と、上を向く面 (菱形)
const silhouette = (cy: number): Point[] => [
  [cx, cy - h],
  [cx + w, cy],
  [cx + w, cy + t],
  [cx, cy + h + t],
  [cx - w, cy + t],
  [cx - w, cy],
];

const topFace = (cy: number): Point[] => [
  [cx, cy - h],
  [cx + w, cy],
  [cx, cy + h],
  [cx - w, cy],
];

// 上面と側面の境目。外形の一部ではないので、控えめな線で引く
const deckFront = (cy: number): Point[] => [
  [cx - w, cy],
  [cx, cy + h],
  [cx + w, cy],
];

const slabPaths = (cy: number) => ({
  body: rounded(silhouette(cy), corner),
  deck: rounded(topFace(cy), corner),
  front: roundedOpen(deckFront(cy), corner),
  seam: { y1: cy + h, y2: cy + h + t - corner },
});

const upper = slabPaths(topY);
const lower = slabPaths(bottomY);

// 上面へ図形を投影する行列。平面座標 -100..100 の正方形が上面の菱形に重なる
// (u,v)=(100,-100) が右の角、(100,100) が手前の角に対応するため除数は 200
const project = (cy: number) => `matrix(${w / 200} ${h / 200} ${-w / 200} ${h / 200} ${cx} ${cy})`;

// Layer 2 の紋: 歯車 (アプリケーション)
const gear = (teeth: number, outer: number, inner: number) => {
  const step = (Math.PI * 2) / teeth;
  const tip = step * 0.26; // 歯先の半幅
  const base = step * 0.42; // 歯元の半幅
  const at = (radius: number, angle: number) =>
    fmt([radius * Math.cos(angle), radius * Math.sin(angle)]);

  const segments: string[] = [];
  for (let i = 0; i < teeth; i++) {
    const a = i * step;
    segments.push(`${i === 0 ? 'M' : 'L'}${at(inner, a - base)}`);
    segments.push(`L${at(outer, a - tip)}`);
    segments.push(`L${at(outer, a + tip)}`);
    segments.push(`L${at(inner, a + base)}`);
  }
  return `${segments.join(' ')} Z`;
};

// Layer 2 の紋: モニタとブラウザ窓、その中のコードと歯車 (アプリケーション)
const monitor = { x: -60, y: -49, w: 120, h: 76, r: 4 };
const screen = { x: -50, y: -39, w: 100, h: 56, r: 2 };
const titleBarY = -27;
const dotY = -33;
const dotsX = [-42.5, -36, -29.5];
const codePaths = [
  'M-32 -14 L-41 -3 L-32 9', // <
  'M-18.5 -15 L-27 10', //      /
  'M-12.5 -14 L-4 -3 L-12.5 9', // >
];
const screenGear = { x: 24, y: -5, path: gear(8, 18, 13), hole: 6.5 };
const buttonY = 23.5;
const buttons = [
  { from: -7.5, to: -1 },
  { from: 3, to: 9.5 },
];
const neckPaths = ['M-11 27 L-16 38', 'M10 27 L15.5 38'];
const base = { x: -33, y: 38, w: 66, h: 11, r: 5 };

// Layer 1 の紋: 書類と虫眼鏡とチェック (記録の検証)。
// 紋は平面座標のまま描くので、辺が土台の稜線と平行になり、面に伏せて見える
const doc = { x: -50, y: -48, w: 60, h: 96, r: 5 };
const docHeading = { x: -40, y: -38, w: 38, h: 10, r: 3 };
const docLineFrom = -40;
const docLines = [
  { y: -18, to: 0 },
  { y: -8, to: -12 },
  { y: 2, to: -4 },
  { y: 12, to: -16 },
];

const lens = { x: 20, y: 26, outer: 26, inner: 22, gap: 3 };
const handle = { x: 24, y: -3.5, w: 30, h: 7, r: 3.5 };
const collarX = 30;

// 虫眼鏡とチェックには決まった向きがないので、投影後の見え方から角度を逆算する。
// 平面上の 19 度は、投影されると画面上で右下 50 度になる
const handleFrame = `translate(${lens.x} ${lens.y}) rotate(19)`;

// チェックは、画面に正立させると面から浮くので、面の向き (画面上で時計回りに
// 60 度) との中間である 30 度だけ倒した位置に置く
const checkPath = 'M7 26 L22.4 37.3 L28 12.9';

// 紋は土台の 60% に収める
const markScale = 'scale(0.6)';
const verifyScale = 'scale(0.72)';

const chevronY = [200, 230, 260];

const notes = {
  left: [
    {
      title: '根拠の供給',
      body: '記録された入力データ、利用者の宣言、統計規則、計算が、生成の根拠になる',
    },
    {
      title: '独立した検証',
      body: 'verifier が Record の内部整合を、当社のソフトウェアに依存せず検証する',
    },
  ],
  right: [
    {
      title: '同一の根拠の上に生成',
      body: '解析、図、Legend、Methods、Results、Claim を Record の上に生成する',
    },
    {
      title: '無効化と再生成',
      body: 'データ・宣言・解析の変更が、影響を受ける成果物を無効化する',
    },
  ],
};
---

<figure class="interaction">
  <div class="notes notes--left">
    {
      notes.left.map((note) => (
        <div class="note">
          <p class="note-title">{note.title}</p>
          <p class="note-body">{note.body}</p>
        </div>
      ))
    }
  </div>

  <div class="stack">
    <p class="stack-label">Layer 2 — nomue（アプリケーション）</p>

    <svg viewBox="0 0 460 480" role="img" aria-labelledby="layer-diagram-title">
      <title id="layer-diagram-title">
        上段の nomue（生成）と下段の nomue Record・verifier（記録と検証）が、上下に往復する等角図
      </title>

      <!-- 軸 -->
      <line class="axis" x1={cx} y1="6" x2={cx} y2={topY - h} />
      <line class="axis" x1={cx} y1={bottomY + h + t} x2={cx} y2="474" />

      <!-- 二つの層をつなぐ垂線 -->
      <line class="link" x1={cx - w} y1={topY + t} x2={cx - w} y2={bottomY} />
      <line class="link" x1={cx + w} y1={topY + t} x2={cx + w} y2={bottomY} />
      <line class="link" x1={cx} y1={topY + h + t} x2={cx} y2={bottomY + h} />

      <!-- 下から上へ: 根拠の供給 -->
      <g class="flow">
        {
          chevronY.map((y, i) => (
            <path
              d={`M144 ${y + 8} L152 ${y} L160 ${y + 8}`}
              style={`animation-delay: ${(chevronY.length - 1 - i) * 0.22}s`}
            />
          ))
        }
      </g>

      <!-- 上から下へ: 記録 -->
      <g class="flow">
        {
          chevronY.map((y, i) => (
            <path
              d={`M300 ${y} L308 ${y + 8} L316 ${y}`}
              style={`animation-delay: ${i * 0.22}s`}
            />
          ))
        }
      </g>

      <!-- Layer 2。外形の輪郭は最後に引き、内側の線に覆われないようにする -->
      <g class="slab">
        <path class="body" d={upper.body} />
        <path class="deck" d={upper.deck} />
        <path class="divider" d={upper.front} />
        <line class="divider" x1={cx} y1={upper.seam.y1} x2={cx} y2={upper.seam.y2} />
        <g class="mark" transform={project(topY)}>
          <g transform={markScale}>
            <rect
              x={monitor.x}
              y={monitor.y}
              width={monitor.w}
              height={monitor.h}
              rx={monitor.r}
              vector-effect="non-scaling-stroke"
            />
            <rect
              x={screen.x}
              y={screen.y}
              width={screen.w}
              height={screen.h}
              rx={screen.r}
              vector-effect="non-scaling-stroke"
            />
            <line
              x1={screen.x}
              y1={titleBarY}
              x2={screen.x + screen.w}
              y2={titleBarY}
              vector-effect="non-scaling-stroke"
            />
            {dotsX.map((x) => <circle class="mark-dot" cx={x} cy={dotY} r="1.6" />)}

            {
              codePaths.map((d) => (
                <path class="mark-line" d={d} vector-effect="non-scaling-stroke" />
              ))
            }

            <g transform={`translate(${screenGear.x} ${screenGear.y})`}>
              <path d={screenGear.path} vector-effect="non-scaling-stroke" />
              <circle cx="0" cy="0" r={screenGear.hole} vector-effect="non-scaling-stroke" />
            </g>

            {
              buttons.map((button) => (
                <line
                  class="mark-line"
                  x1={button.from}
                  y1={buttonY}
                  x2={button.to}
                  y2={buttonY}
                  vector-effect="non-scaling-stroke"
                />
              ))
            }

            {neckPaths.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
            <rect
              x={base.x}
              y={base.y}
              width={base.w}
              height={base.h}
              rx={base.r}
              vector-effect="non-scaling-stroke"
            />
          </g>
        </g>
        <path class="outline" d={upper.body} />
      </g>

      <!-- Layer 1 -->
      <g class="slab">
        <path class="body" d={lower.body} />
        <path class="deck" d={lower.deck} />
        <path class="divider" d={lower.front} />
        <line class="divider" x1={cx} y1={lower.seam.y1} x2={cx} y2={lower.seam.y2} />
        <g class="mark" transform={project(bottomY)}>
          <g transform={verifyScale}>
            <rect
              x={doc.x}
              y={doc.y}
              width={doc.w}
              height={doc.h}
              rx={doc.r}
              vector-effect="non-scaling-stroke"
            />
            <rect
              x={docHeading.x}
              y={docHeading.y}
              width={docHeading.w}
              height={docHeading.h}
              rx={docHeading.r}
              vector-effect="non-scaling-stroke"
            />
            {
              docLines.map((line) => (
                <line
                  class="mark-line"
                  x1={docLineFrom}
                  y1={line.y}
                  x2={line.to}
                  y2={line.y}
                  vector-effect="non-scaling-stroke"
                />
              ))
            }

            {/* 虫眼鏡の下敷き。書類の線を抜いて、重なりに余白をつくる */}
            <g class="mark-knockout">
              <circle cx={lens.x} cy={lens.y} r={lens.outer + lens.gap} />
              <g transform={handleFrame}>
                <rect
                  x={handle.x}
                  y={handle.y}
                  width={handle.w}
                  height={handle.h}
                  rx={handle.r}
                  vector-effect="non-scaling-stroke"
                />
              </g>
            </g>

            {/* 持ち手は先に引き、塗りのあるレンズで根元を隠す */}
            <g transform={handleFrame}>
              <rect
                x={handle.x}
                y={handle.y}
                width={handle.w}
                height={handle.h}
                rx={handle.r}
                vector-effect="non-scaling-stroke"
              />
              <line
                x1={collarX}
                y1={handle.y}
                x2={collarX}
                y2={handle.y + handle.h}
                vector-effect="non-scaling-stroke"
              />
            </g>

            <circle
              class="lens"
              cx={lens.x}
              cy={lens.y}
              r={lens.outer}
              vector-effect="non-scaling-stroke"
            />
            <circle cx={lens.x} cy={lens.y} r={lens.inner} vector-effect="non-scaling-stroke" />
            <path class="mark-line" d={checkPath} vector-effect="non-scaling-stroke" />
          </g>
        </g>
        <path class="outline" d={lower.body} />
      </g>
    </svg>

    <p class="stack-label">Layer 1 — nomue Record ＋ verifier</p>
  </div>

  <div class="notes notes--right">
    {
      notes.right.map((note) => (
        <div class="note">
          <p class="note-title">{note.title}</p>
          <p class="note-body">{note.body}</p>
        </div>
      ))
    }
  </div>

  <figcaption class="placeholder">
    [図: Evidence →（宣言・規則・計算）→ Outputs。下層に Record（記録）と Verifier（第三者検証）を貫通させる層構造図]
  </figcaption>
</figure>

<style>
  .interaction {
    margin: 3.5rem 0 0;
    display: grid;
    /* 中央は明示的に幅を与える。auto だと SVG の既定サイズ (300px) で決まってしまう */
    grid-template-columns: minmax(0, 1fr) 26rem minmax(0, 1fr);
    align-items: center;
    gap: 2.5rem;
  }

  .stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .stack-label {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    text-align: center;
  }

  /* 面は薄いグレーの塗りだけ。奥の線はこの塗りで隠れる */
  .body {
    fill: var(--wash-lo);
  }

  .deck {
    fill: var(--wash-hi);
  }

  /* 外形の輪郭だけをはっきり引く */
  .outline {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.25;
    stroke-linejoin: round;
  }

  /* 内側の区切り (上面と側面の境目、手前の稜線) は控えめに */
  .divider {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .mark path,
  .mark circle,
  .mark rect,
  .mark line {
    fill: none;
    stroke: var(--ink-4);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .mark .mark-line {
    stroke-linecap: round;
  }

  .mark .mark-dot {
    fill: var(--ink-4);
    stroke: none;
  }

  /* 背後の線を面の色で抜き、紋の要素どうしに余白をつくる */
  .mark .mark-knockout circle,
  .mark .mark-knockout rect {
    fill: var(--wash-hi);
    stroke: var(--wash-hi);
    stroke-width: 4;
  }

  /* レンズは面の色で塗り、下を通る持ち手の根元を隠す */
  .mark .lens {
    fill: var(--wash-hi);
  }

  .axis {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .link {
    stroke: var(--ink-4);
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }

  .flow path {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: flow-pulse 3.2s ease-in-out infinite;
  }

  @keyframes flow-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    45% {
      opacity: 1;
    }
  }

  .notes {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .notes--left {
    text-align: right;
  }

  .note-title {
    margin: 0 0 0.4rem;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .note-body {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--ink-3);
  }

  figcaption {
    grid-column: 1 / -1;
    margin-top: 2.5rem;
    font-size: 0.8rem;
    line-height: 1.6;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .flow path {
      animation: none;
      opacity: 0.6;
    }
  }

  @media (max-width: 900px) {
    .interaction {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .stack {
      order: -1;
      max-width: 26rem;
      margin: 0 auto;
    }

    .notes--left {
      text-align: left;
    }

    .notes {
      gap: 2rem;
    }

    figcaption {
      text-align: left;
    }
  }
</style>
