---
// What We Build の図。左に二層の等角図、右に対応する本文を置く。
// 本文の Layer 1 → Layer 2 の順序を正本とし、図も上段に Layer 1 (Record ＋ verifier)、
// 下段に Layer 2 (アプリケーション) を置く。左列の矢印が上から下 (根拠の供給)、
// 右列が下から上 (Record の上への生成) を表す。
//
// 図の列は本文の列と高さを共有する。菱形は 2 枚の SVG に分かれていて大きさは
// 固定、あいだの接続部 (点線・矢印) だけが伸縮して本文の高さに追従する。

interface Props {
  layers: { n: string; title: string; body: string }[];
}

const { layers } = Astro.props;

type Point = [number, number];

// 等角の基準寸法: 上面の菱形は半幅 w・半高 h、側面の厚みが t
const w = 150;
const h = 86;
const t = 40;
const cx = 230;
const cy = 110; // 各 SVG 内での上面の中心。上下の菱形で共通
const corner = 4; // 角の丸み。輪郭がわずかに和らぐ程度に留める

const fmt = ([x, y]: Point) => `${x.toFixed(1)} ${y.toFixed(1)}`;

// from から to の向きに radius だけ進んだ点。角を丸めるための切り取り位置
const toward = (from: Point, to: Point, radius: number): Point => {
  const dx = to[0] - from[0];
  const dy = to[1] - from[1];
  const length = Math.hypot(dx, dy);
  const r = Math.min(radius, length / 2);
  return [from[0] + (dx / length) * r, from[1] + (dy / length) * r];
};

// 多角形の角を丸めたパスを作る。各頂点の手前で辺を切り、頂点を制御点にした曲線でつなぐ
const rounded = (points: Point[], radius: number) => {
  const n = points.length;
  const segments: string[] = [];

  for (let i = 0; i < n; i++) {
    const previous = points[(i - 1 + n) % n]!;
    const current = points[i]!;
    const next = points[(i + 1) % n]!;

    segments.push(`${i === 0 ? 'M' : 'L'}${fmt(toward(current, previous, radius))}`);
    segments.push(`Q${fmt(current)} ${fmt(toward(current, next, radius))}`);
  }

  return `${segments.join(' ')} Z`;
};

// 閉じない折れ線。両端はそのまま、途中の角だけ丸める
const roundedOpen = (points: Point[], radius: number) => {
  const segments: string[] = [`M${fmt(points[0]!)}`];

  for (let i = 1; i < points.length - 1; i++) {
    const current = points[i]!;
    segments.push(`L${fmt(toward(current, points[i - 1]!, radius))}`);
    segments.push(`Q${fmt(current)} ${fmt(toward(current, points[i + 1]!, radius))}`);
  }

  segments.push(`L${fmt(points[points.length - 1]!)}`);
  return segments.join(' ');
};

// 立体の外形 (六角形) と、上を向く面 (菱形)
const silhouette = (): Point[] => [
  [cx, cy - h],
  [cx + w, cy],
  [cx + w, cy + t],
  [cx, cy + h + t],
  [cx - w, cy + t],
  [cx - w, cy],
];

const topFace = (): Point[] => [
  [cx, cy - h],
  [cx + w, cy],
  [cx, cy + h],
  [cx - w, cy],
];

// 上面と側面の境目。外形の一部ではないので、控えめな線で引く
const deckFront = (): Point[] => [
  [cx - w, cy],
  [cx, cy + h],
  [cx + w, cy],
];

const slab = {
  body: rounded(silhouette(), corner),
  deck: rounded(topFace(), corner),
  front: roundedOpen(deckFront(), corner),
  seam: { y1: cy + h, y2: cy + h + t - corner },
};

// 上面へ図形を投影する行列。平面座標 -100..100 の正方形が上面の菱形に重なる
// (u,v)=(100,-100) が右の角、(100,100) が手前の角に対応するため除数は 200
const project = `matrix(${w / 200} ${h / 200} ${-w / 200} ${h / 200} ${cx} ${cy})`;

// Layer 2 の紋: 歯車 (アプリケーション)
const gear = (teeth: number, outer: number, inner: number) => {
  const step = (Math.PI * 2) / teeth;
  const tip = step * 0.26; // 歯先の半幅
  const base = step * 0.42; // 歯元の半幅
  const at = (radius: number, angle: number) =>
    fmt([radius * Math.cos(angle), radius * Math.sin(angle)]);

  const segments: string[] = [];
  for (let i = 0; i < teeth; i++) {
    const a = i * step;
    segments.push(`${i === 0 ? 'M' : 'L'}${at(inner, a - base)}`);
    segments.push(`L${at(outer, a - tip)}`);
    segments.push(`L${at(outer, a + tip)}`);
    segments.push(`L${at(inner, a + base)}`);
  }
  return `${segments.join(' ')} Z`;
};

// Layer 2 の紋: モニタとブラウザ窓、その中のコードと歯車 (アプリケーション)
const monitor = { x: -60, y: -49, w: 120, h: 76, r: 4 };
const screen = { x: -50, y: -39, w: 100, h: 56, r: 2 };
const titleBarY = -27;
const dotY = -33;
const dotsX = [-42.5, -36, -29.5];
const codePaths = [
  'M-32 -14 L-41 -3 L-32 9', // <
  'M-18.5 -15 L-27 10', //      /
  'M-12.5 -14 L-4 -3 L-12.5 9', // >
];
const screenGear = { x: 24, y: -5, path: gear(8, 18, 13), hole: 6.5 };
const buttonY = 23.5;
const buttons = [
  { from: -7.5, to: -1 },
  { from: 3, to: 9.5 },
];
const neckPaths = ['M-11 27 L-16 38', 'M10 27 L15.5 38'];
const base = { x: -33, y: 38, w: 66, h: 11, r: 5 };

// Layer 1 の紋: 書類と虫眼鏡とチェック (記録の検証)。
// 紋は平面座標のまま描くので、辺が土台の稜線と平行になり、面に伏せて見える
const doc = { x: -50, y: -48, w: 60, h: 96, r: 5 };
const docHeading = { x: -40, y: -38, w: 38, h: 10, r: 3 };
const docLineFrom = -40;
const docLines = [
  { y: -18, to: 0 },
  { y: -8, to: -12 },
  { y: 2, to: -4 },
  { y: 12, to: -16 },
];

const lens = { x: 20, y: 26, outer: 26, inner: 22, gap: 3 };
const handle = { x: 24, y: -3.5, w: 30, h: 7, r: 3.5 };
const collarX = 30;

// 紋は土台の右下の辺を地面として置く。平面座標をさらに -90 度回すと、紋の下辺が
// その稜線と平行になる。紋は土台の 60% に収める
const ground = -90;
const markFrame = `scale(0.6) rotate(${ground})`;
const verifyFrame = `scale(0.72) rotate(${ground})`;

// 虫眼鏡は面に伏せた一つの剛体として扱い、面内で 45 度だけ回す。枠の回転を
// 差し引くと虫眼鏡だけが地面から起き上がって見えるので、ここでは差し引かない
const lensFrame = `translate(${lens.x} ${lens.y}) rotate(45)`;

// チェックは虫眼鏡の持ち物ではなく Record の上の記号なので、虫眼鏡と一緒には
// 回さず、紋の枠のまま地面に正立させる。腕は一般的なチェックの比率 (短腕 54 度・
// 長腕 -49 度、長さ 1:1.75) をそのまま使う。投影後は 5 度 / -97 度になり、地面
// (右下辺 -29.83 度) とも左下辺 (+29.83 度) とも平行にならない。書類と同じ「上」を
// 向くので、面の上に立った記号として読める
const checkFrame = `translate(${lens.x} ${lens.y})`;
const checkPath = 'M-10.4 -1.8 L-3.4 7.9 L10.4 -7.9';

// 矢印は接続部の中央に固定サイズで置く
const chevronY = [0, 30, 60];
---

<div class="interaction">
  <figure class="diagram">
    <div
      class="stack"
      role="img"
      aria-label="上段の nomue Record・verifier（記録と検証）と下段の nomue（生成）のあいだを、根拠と成果物が往復する等角図"
    >
      <!-- Layer 1。外形の輪郭は最後に引き、内側の線に覆われないようにする -->
      <svg class="slab-svg" viewBox="70 4 320 234" aria-hidden="true">
        <line class="axis" x1={cx} y1="6" x2={cx} y2={cy - h} />
        <g class="slab">
          <path class="body" d={slab.body} />
          <path class="deck" d={slab.deck} />
          <path class="divider" d={slab.front} />
          <line class="divider" x1={cx} y1={slab.seam.y1} x2={cx} y2={slab.seam.y2} />
          <g class="mark" transform={project}>
            <g transform={verifyFrame}>
              <rect
                x={doc.x}
                y={doc.y}
                width={doc.w}
                height={doc.h}
                rx={doc.r}
                vector-effect="non-scaling-stroke"
              />
              <rect
                x={docHeading.x}
                y={docHeading.y}
                width={docHeading.w}
                height={docHeading.h}
                rx={docHeading.r}
                vector-effect="non-scaling-stroke"
              />
              {
                docLines.map((line) => (
                  <line
                    class="mark-line"
                    x1={docLineFrom}
                    y1={line.y}
                    x2={line.to}
                    y2={line.y}
                    vector-effect="non-scaling-stroke"
                  />
                ))
              }

              {/* 虫眼鏡の下敷き。書類の線を抜いて、重なりに余白をつくる */}
              <g class="mark-knockout">
                <circle cx={lens.x} cy={lens.y} r={lens.outer + lens.gap} />
                <g transform={lensFrame}>
                  <rect
                    x={handle.x}
                    y={handle.y}
                    width={handle.w}
                    height={handle.h}
                    rx={handle.r}
                    vector-effect="non-scaling-stroke"
                  />
                </g>
              </g>

              {/* 持ち手は先に引き、塗りのあるレンズで根元を隠す */}
              <g transform={lensFrame}>
                <rect
                  x={handle.x}
                  y={handle.y}
                  width={handle.w}
                  height={handle.h}
                  rx={handle.r}
                  vector-effect="non-scaling-stroke"
                />
                <line
                  x1={collarX}
                  y1={handle.y}
                  x2={collarX}
                  y2={handle.y + handle.h}
                  vector-effect="non-scaling-stroke"
                />
              </g>

              <circle
                class="lens"
                cx={lens.x}
                cy={lens.y}
                r={lens.outer}
                vector-effect="non-scaling-stroke"
              />
              <circle cx={lens.x} cy={lens.y} r={lens.inner} vector-effect="non-scaling-stroke" />
              <g transform={checkFrame}>
                <path class="mark-line" d={checkPath} vector-effect="non-scaling-stroke" />
              </g>
            </g>
          </g>
          <path class="outline" d={slab.body} />
        </g>
      </svg>

      <!-- 本文の高さに追従して伸縮する接続部 -->
      <div class="gap" aria-hidden="true"></div>

      <!-- Layer 2 -->
      <svg class="slab-svg" viewBox="70 22 320 234" aria-hidden="true">
        <line class="axis" x1={cx} y1={cy + h + t} x2={cx} y2={cy + h + t + 18} />
        <g class="slab">
          <path class="body" d={slab.body} />
          <path class="deck" d={slab.deck} />
          <path class="divider" d={slab.front} />
          <line class="divider" x1={cx} y1={slab.seam.y1} x2={cx} y2={slab.seam.y2} />
          <g class="mark" transform={project}>
            <g transform={markFrame}>
              <rect
                x={monitor.x}
                y={monitor.y}
                width={monitor.w}
                height={monitor.h}
                rx={monitor.r}
                vector-effect="non-scaling-stroke"
              />
              <rect
                x={screen.x}
                y={screen.y}
                width={screen.w}
                height={screen.h}
                rx={screen.r}
                vector-effect="non-scaling-stroke"
              />
              <line
                x1={screen.x}
                y1={titleBarY}
                x2={screen.x + screen.w}
                y2={titleBarY}
                vector-effect="non-scaling-stroke"
              />
              {dotsX.map((x) => <circle class="mark-dot" cx={x} cy={dotY} r="1.6" />)}

              {
                codePaths.map((d) => (
                  <path class="mark-line" d={d} vector-effect="non-scaling-stroke" />
                ))
              }

              <g transform={`translate(${screenGear.x} ${screenGear.y})`}>
                <path d={screenGear.path} vector-effect="non-scaling-stroke" />
                <circle cx="0" cy="0" r={screenGear.hole} vector-effect="non-scaling-stroke" />
              </g>

              {
                buttons.map((button) => (
                  <line
                    class="mark-line"
                    x1={button.from}
                    y1={buttonY}
                    x2={button.to}
                    y2={buttonY}
                    vector-effect="non-scaling-stroke"
                  />
                ))
              }

              {neckPaths.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
              <rect
                x={base.x}
                y={base.y}
                width={base.w}
                height={base.h}
                rx={base.r}
                vector-effect="non-scaling-stroke"
              />
            </g>
          </g>
          <path class="outline" d={slab.body} />
        </g>
      </svg>

      <!-- 二つの菱形をつなぐ点線と矢印。菱形の SVG の背後に敷く -->
      <div class="links" aria-hidden="true">
        <span class="link link--left"></span>
        <span class="link link--center"></span>
        <span class="link link--right"></span>
        <svg class="flows" viewBox="70 0 320 76">
          <!-- 上から下へ: 根拠の供給 (Layer 1 → Layer 2) -->
          <g class="flow">
            {
              chevronY.map((y, i) => (
                <path
                  d={`M144 ${y + 4} L152 ${y + 12} L160 ${y + 4}`}
                  style={`animation-delay: ${i * 0.22}s`}
                />
              ))
            }
          </g>
          <!-- 下から上へ: Record の上への生成 (Layer 2 → Layer 1) -->
          <g class="flow">
            {
              chevronY.map((y, i) => (
                <path
                  d={`M300 ${y + 12} L308 ${y + 4} L316 ${y + 12}`}
                  style={`animation-delay: ${(chevronY.length - 1 - i) * 0.22}s`}
                />
              ))
            }
          </g>
        </svg>
      </div>
    </div>

    <figcaption class="placeholder">
      [図: Evidence →（宣言・規則・計算）→ Outputs。下層に Record（記録）と Verifier（第三者検証）を貫通させる層構造図]
    </figcaption>
  </figure>

  <ol class="layers">
    {
      layers.map((layer) => (
        <li>
          <p class="layer-n">{layer.n}</p>
          <h3>{layer.title}</h3>
          <p>{layer.body}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  /* 図の列と本文の列を一つのグリッドで持つ。図の注釈 (figcaption) は行 2 に
     追い出し、行 1 の高さは本文と図の大きいほうが決める */
  .interaction {
    display: grid;
    grid-template-columns: minmax(0, 18.5rem) minmax(0, 1fr);
    column-gap: 3rem;
  }

  .diagram {
    display: contents;
  }

  /* 菱形 2 枚は大きさ固定のまま、あいだの .gap だけが行の高さに合わせて伸縮する。
     点線や矢印の位置は列幅に対する比 (cqw) で決まるので、高さに依存しない */
  .stack {
    grid-column: 1;
    grid-row: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    container-type: inline-size;
  }

  .slab-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    position: relative;
    z-index: 1;
  }

  .gap {
    flex: 1 1 auto;
    /* 本文が図より低いときの、菱形どうしの最小間隔 */
    min-height: 0.5rem;
  }

  .links {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* 点線は 1px 幅の縦帯を繰り返しグラデーションで塗る。SVG の stroke と違い、
     高さが変わっても破線の刻みが伸びない */
  .link {
    position: absolute;
    width: 1px;
    background: repeating-linear-gradient(
      to bottom,
      var(--ink-4) 0 2px,
      transparent 2px 7px
    );
  }

  /* 3.125cqw = 菱形の左右の角の x 位置 (viewBox 内 80/320)。
     45.625cqw = 角の y 位置、72.5cqw = 手前の頂点の y 位置を列幅比に直した値 */
  .link--left {
    left: calc(3.125cqw - 0.5px);
    top: 45.625cqw;
    bottom: 45.625cqw;
  }

  .link--right {
    right: calc(3.125cqw - 0.5px);
    top: 45.625cqw;
    bottom: 45.625cqw;
  }

  .link--center {
    left: calc(50% - 0.5px);
    top: 72.5cqw;
    bottom: 72.5cqw;
  }

  .flows {
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 23.75cqw;
    transform: translateY(-50%);
    overflow: visible;
  }

  .layers {
    grid-column: 2;
    grid-row: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-rows: 1fr 1fr;
    align-items: center;
    row-gap: 2rem;
  }

  /* 図は上下の菱形が列の両端に付くので、本文も Layer 1 を上端、Layer 2 を
     下端に揃える。これで図と本文の上下の縁が常に一致する */
  .layers li:first-child {
    align-self: start;
  }

  .layers li:last-child {
    align-self: end;
  }

  .layers li {
    max-width: var(--measure);
  }

  .layer-n {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .layers h3 {
    font-size: 1.05rem;
    margin-bottom: 0.6rem;
  }

  .layers p:last-child {
    margin-bottom: 0;
    color: var(--ink-2);
  }

  figcaption {
    grid-column: 1 / -1;
    grid-row: 2;
    margin-top: 2.5rem;
    font-size: 0.8rem;
    line-height: 1.6;
    text-align: center;
  }

  /* 面は薄いグレーの塗りだけ。奥の線はこの塗りで隠れる */
  .body {
    fill: var(--wash-lo);
  }

  .deck {
    fill: var(--wash-hi);
  }

  /* 外形の輪郭だけをはっきり引く */
  .outline {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.25;
    stroke-linejoin: round;
  }

  /* 内側の区切り (上面と側面の境目、手前の稜線) は控えめに */
  .divider {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .mark path,
  .mark circle,
  .mark rect,
  .mark line {
    fill: none;
    stroke: var(--ink-4);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .mark .mark-line {
    stroke-linecap: round;
  }

  .mark .mark-dot {
    fill: var(--ink-4);
    stroke: none;
  }

  /* 背後の線を面の色で抜き、紋の要素どうしに余白をつくる */
  .mark .mark-knockout circle,
  .mark .mark-knockout rect {
    fill: var(--wash-hi);
    stroke: var(--wash-hi);
    stroke-width: 4;
  }

  /* レンズは面の色で塗り、下を通る持ち手の根元を隠す */
  .mark .lens {
    fill: var(--wash-hi);
  }

  .axis {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .flow path {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: flow-pulse 3.2s ease-in-out infinite;
  }

  @keyframes flow-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    45% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow path {
      animation: none;
      opacity: 0.6;
    }
  }

  /* 1 ペインで中央寄せ (幅 56rem ＋ 左右の余白 2.5rem) が入らなくなる幅で縦積みへ */
  @media (max-width: 980px) {
    .interaction {
      grid-template-columns: minmax(0, 1fr);
    }

    .stack {
      justify-self: center;
      width: min(100%, 23rem);
    }

    /* 縦積みでは本文が高さを決めないので、接続部は固定の間隔にする */
    .gap {
      flex: 0 0 auto;
      min-height: 1.5rem;
    }

    .layers {
      grid-column: 1;
      grid-row: 2;
      grid-template-rows: none;
      margin-top: 2.5rem;
    }

    figcaption {
      grid-row: 3;
      text-align: left;
    }
  }
</style>
