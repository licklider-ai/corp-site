---
// What We Build の図。左に二層の等角図、右に対応する本文を置く。
// 本文の Layer 1 → Layer 2 の順序を正本とし、図も上段に Layer 1 (Record ＋ verifier)、
// 下段に Layer 2 (アプリケーション) を置く。左列の矢印が上から下 (根拠の供給)、
// 右列が下から上 (Record の上への生成) を表す。
//
// 図の列は本文の列と同じグリッド行を共有する。各菱形はそれぞれの本文と同じ行の
// 上端に付くので、菱形の縦位置と本文の開始位置が常に一致する。行間の距離は本文の
// 高さが決め、菱形をつなぐ点線がその距離に追従して伸縮する。

interface Props {
  layers: { n: string; title: string; body: string }[];
}

const { layers } = Astro.props;

type Point = [number, number];

// 等角の基準寸法: 上面の菱形は半幅 w・半高 h、側面の厚みが t
const w = 150;
const h = 86;
const t = 40;
const cx = 230;
const cy = 110; // 各 SVG 内での上面の中心。上下の菱形で共通
const corner = 4; // 角の丸み。輪郭がわずかに和らぐ程度に留める

const fmt = ([x, y]: Point) => `${x.toFixed(1)} ${y.toFixed(1)}`;

// from から to の向きに radius だけ進んだ点。角を丸めるための切り取り位置
const toward = (from: Point, to: Point, radius: number): Point => {
  const dx = to[0] - from[0];
  const dy = to[1] - from[1];
  const length = Math.hypot(dx, dy);
  const r = Math.min(radius, length / 2);
  return [from[0] + (dx / length) * r, from[1] + (dy / length) * r];
};

// 多角形の角を丸めたパスを作る。各頂点の手前で辺を切り、頂点を制御点にした曲線でつなぐ
const rounded = (points: Point[], radius: number) => {
  const n = points.length;
  const segments: string[] = [];

  for (let i = 0; i < n; i++) {
    const previous = points[(i - 1 + n) % n]!;
    const current = points[i]!;
    const next = points[(i + 1) % n]!;

    segments.push(`${i === 0 ? 'M' : 'L'}${fmt(toward(current, previous, radius))}`);
    segments.push(`Q${fmt(current)} ${fmt(toward(current, next, radius))}`);
  }

  return `${segments.join(' ')} Z`;
};

// 閉じない折れ線。両端はそのまま、途中の角だけ丸める
const roundedOpen = (points: Point[], radius: number) => {
  const segments: string[] = [`M${fmt(points[0]!)}`];

  for (let i = 1; i < points.length - 1; i++) {
    const current = points[i]!;
    segments.push(`L${fmt(toward(current, points[i - 1]!, radius))}`);
    segments.push(`Q${fmt(current)} ${fmt(toward(current, points[i + 1]!, radius))}`);
  }

  segments.push(`L${fmt(points[points.length - 1]!)}`);
  return segments.join(' ');
};

// 立体の外形 (六角形) と、上を向く面 (菱形)
const silhouette = (): Point[] => [
  [cx, cy - h],
  [cx + w, cy],
  [cx + w, cy + t],
  [cx, cy + h + t],
  [cx - w, cy + t],
  [cx - w, cy],
];

const topFace = (): Point[] => [
  [cx, cy - h],
  [cx + w, cy],
  [cx, cy + h],
  [cx - w, cy],
];

// 上面と側面の境目。外形の一部ではないので、控えめな線で引く
const deckFront = (): Point[] => [
  [cx - w, cy],
  [cx, cy + h],
  [cx + w, cy],
];

const slab = {
  body: rounded(silhouette(), corner),
  deck: rounded(topFace(), corner),
  front: roundedOpen(deckFront(), corner),
  seam: { y1: cy + h, y2: cy + h + t - corner },
};

// 上面へ図形を投影する行列。平面座標 -100..100 の正方形が上面の菱形に重なる
// (u,v)=(100,-100) が右の角、(100,100) が手前の角に対応するため除数は 200
const project = `matrix(${w / 200} ${h / 200} ${-w / 200} ${h / 200} ${cx} ${cy})`;

// Layer 2 の紋: 歯車 (アプリケーション)
const gear = (teeth: number, outer: number, inner: number) => {
  const step = (Math.PI * 2) / teeth;
  const tip = step * 0.26; // 歯先の半幅
  const base = step * 0.42; // 歯元の半幅
  const at = (radius: number, angle: number) =>
    fmt([radius * Math.cos(angle), radius * Math.sin(angle)]);

  const segments: string[] = [];
  for (let i = 0; i < teeth; i++) {
    const a = i * step;
    segments.push(`${i === 0 ? 'M' : 'L'}${at(inner, a - base)}`);
    segments.push(`L${at(outer, a - tip)}`);
    segments.push(`L${at(outer, a + tip)}`);
    segments.push(`L${at(inner, a + base)}`);
  }
  return `${segments.join(' ')} Z`;
};

// Layer 2 の紋: モニタとブラウザ窓、その中のコードと歯車 (アプリケーション)
const monitor = { x: -60, y: -49, w: 120, h: 76, r: 4 };
const screen = { x: -50, y: -39, w: 100, h: 56, r: 2 };
const titleBarY = -27;
const dotY = -33;
const dotsX = [-42.5, -36, -29.5];
const codePaths = [
  'M-32 -14 L-41 -3 L-32 9', // <
  'M-18.5 -15 L-27 10', //      /
  'M-12.5 -14 L-4 -3 L-12.5 9', // >
];
const screenGear = { x: 24, y: -5, path: gear(8, 18, 13), hole: 6.5 };
const buttonY = 23.5;
const buttons = [
  { from: -7.5, to: -1 },
  { from: 3, to: 9.5 },
];
const neckPaths = ['M-11 27 L-16 38', 'M10 27 L15.5 38'];
const base = { x: -33, y: 38, w: 66, h: 11, r: 5 };

// Layer 1 の紋: 書類と虫眼鏡とチェック (記録の検証)。
// 紋は平面座標のまま描くので、辺が土台の稜線と平行になり、面に伏せて見える
const doc = { x: -50, y: -48, w: 60, h: 96, r: 5 };
const docHeading = { x: -40, y: -38, w: 38, h: 10, r: 3 };
const docLineFrom = -40;
const docLines = [
  { y: -18, to: 0 },
  { y: -8, to: -12 },
  { y: 2, to: -4 },
  { y: 12, to: -16 },
];

const lens = { x: 20, y: 26, outer: 26, inner: 22, gap: 3 };
const handle = { x: 24, y: -3.5, w: 30, h: 7, r: 3.5 };
const collarX = 30;

// 紋は土台の右下の辺を地面として置く。平面座標をさらに -90 度回すと、紋の下辺が
// その稜線と平行になる。紋は土台の 60% に収める
const ground = -90;
const markFrame = `scale(0.6) rotate(${ground})`;
const verifyFrame = `scale(0.72) rotate(${ground})`;

// 虫眼鏡は面に伏せた一つの剛体として扱い、面内で 45 度だけ回す。枠の回転を
// 差し引くと虫眼鏡だけが地面から起き上がって見えるので、ここでは差し引かない
const lensFrame = `translate(${lens.x} ${lens.y}) rotate(45)`;

// チェックは虫眼鏡の持ち物ではなく Record の上の記号なので、虫眼鏡と一緒には
// 回さず、紋の枠のまま地面に正立させる。腕は一般的なチェックの比率 (短腕 54 度・
// 長腕 -49 度、長さ 1:1.75) をそのまま使う。投影後は 5 度 / -97 度になり、地面
// (右下辺 -29.83 度) とも左下辺 (+29.83 度) とも平行にならない。書類と同じ「上」を
// 向くので、面の上に立った記号として読める
const checkFrame = `translate(${lens.x} ${lens.y})`;
const checkPath = 'M-10.4 -1.8 L-3.4 7.9 L10.4 -7.9';

// 矢印は菱形 1 と 2 の中間にベルトコンベア状に流す。窓 (高さ 76) の外に 1 つ
// 余分に置き、1 周期 (間隔 30) ぶん平行移動してループすると継ぎ目が見えない
const downChevronY = [-30, 0, 30, 60];
const upChevronY = [0, 30, 60, 90];
---

<div class="interaction">
  <figure class="diagram">
    <p class="visually-hidden">
      Isometric diagram: evidence and outputs cycle between nomue Record and verifier (recording and verification) above, and nomue (generation) below
    </p>

    <!-- Layer 1. Pinned to the top of row 1, aligned with the start of its text -->
    <svg class="slab-svg slab-svg--1" viewBox="70 22 320 216" aria-hidden="true">
      <g class="slab">
          <path class="body" d={slab.body} />
          <path class="deck" d={slab.deck} />
          <path class="divider" d={slab.front} />
          <line class="divider" x1={cx} y1={slab.seam.y1} x2={cx} y2={slab.seam.y2} />
          <g class="mark" transform={project}>
            <g transform={verifyFrame}>
              <rect
                x={doc.x}
                y={doc.y}
                width={doc.w}
                height={doc.h}
                rx={doc.r}
                vector-effect="non-scaling-stroke"
              />
              <rect
                x={docHeading.x}
                y={docHeading.y}
                width={docHeading.w}
                height={docHeading.h}
                rx={docHeading.r}
                vector-effect="non-scaling-stroke"
              />
              {
                docLines.map((line) => (
                  <line
                    class="mark-line"
                    x1={docLineFrom}
                    y1={line.y}
                    x2={line.to}
                    y2={line.y}
                    vector-effect="non-scaling-stroke"
                  />
                ))
              }

              {/* 虫眼鏡の下敷き。書類の線を抜いて、重なりに余白をつくる */}
              <g class="mark-knockout">
                <circle cx={lens.x} cy={lens.y} r={lens.outer + lens.gap} />
                <g transform={lensFrame}>
                  <rect
                    x={handle.x}
                    y={handle.y}
                    width={handle.w}
                    height={handle.h}
                    rx={handle.r}
                    vector-effect="non-scaling-stroke"
                  />
                </g>
              </g>

              {/* 持ち手は先に引き、塗りのあるレンズで根元を隠す */}
              <g transform={lensFrame}>
                <rect
                  x={handle.x}
                  y={handle.y}
                  width={handle.w}
                  height={handle.h}
                  rx={handle.r}
                  vector-effect="non-scaling-stroke"
                />
                <line
                  x1={collarX}
                  y1={handle.y}
                  x2={collarX}
                  y2={handle.y + handle.h}
                  vector-effect="non-scaling-stroke"
                />
              </g>

              <circle
                class="lens"
                cx={lens.x}
                cy={lens.y}
                r={lens.outer}
                vector-effect="non-scaling-stroke"
              />
              <circle cx={lens.x} cy={lens.y} r={lens.inner} vector-effect="non-scaling-stroke" />
              <g transform={checkFrame}>
                <path class="mark-line" d={checkPath} vector-effect="non-scaling-stroke" />
              </g>
            </g>
          </g>
          <path class="outline" d={slab.body} />
        </g>
    </svg>

    <!-- Layer 2. Pinned to the top of row 2. The face line continues the center
         line descending from Layer 1, crossing the top face to the front vertex -->
    <div class="slab2" aria-hidden="true">
      <svg class="slab-svg" viewBox="70 22 320 216">
        <g class="slab">
          <path class="body" d={slab.body} />
          <path class="deck" d={slab.deck} />
          <path class="divider" d={slab.front} />
          <line class="divider" x1={cx} y1={slab.seam.y1} x2={cx} y2={slab.seam.y2} />
          <g class="mark" transform={project}>
            <g transform={markFrame}>
              <rect
                x={monitor.x}
                y={monitor.y}
                width={monitor.w}
                height={monitor.h}
                rx={monitor.r}
                vector-effect="non-scaling-stroke"
              />
              <rect
                x={screen.x}
                y={screen.y}
                width={screen.w}
                height={screen.h}
                rx={screen.r}
                vector-effect="non-scaling-stroke"
              />
              <line
                x1={screen.x}
                y1={titleBarY}
                x2={screen.x + screen.w}
                y2={titleBarY}
                vector-effect="non-scaling-stroke"
              />
              {dotsX.map((x) => <circle class="mark-dot" cx={x} cy={dotY} r="1.6" />)}

              {
                codePaths.map((d) => (
                  <path class="mark-line" d={d} vector-effect="non-scaling-stroke" />
                ))
              }

              <g transform={`translate(${screenGear.x} ${screenGear.y})`}>
                <path d={screenGear.path} vector-effect="non-scaling-stroke" />
                <circle cx="0" cy="0" r={screenGear.hole} vector-effect="non-scaling-stroke" />
              </g>

              {
                buttons.map((button) => (
                  <line
                    class="mark-line"
                    x1={button.from}
                    y1={buttonY}
                    x2={button.to}
                    y2={buttonY}
                    vector-effect="non-scaling-stroke"
                  />
                ))
              }

              {neckPaths.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
              <rect
                x={base.x}
                y={base.y}
                width={base.w}
                height={base.h}
                rx={base.r}
                vector-effect="non-scaling-stroke"
              />
            </g>
          </g>
          <path class="outline" d={slab.body} />
        </g>
      </svg>
      <span class="link link--face"></span>
    </div>

    <!-- Dotted links and flow arrows between the two slabs. The links drop from
         behind row 1 to the corners of slab 2; the arrows sit midway between them -->
    <div class="links" aria-hidden="true">
      <span class="link link--left"></span>
      <span class="link link--center"></span>
      <span class="link link--right"></span>
      <svg class="flows" viewBox="70 0 320 76">
        <!-- Downward: supplying evidence (Layer 1 → Layer 2) -->
        <g class="flow flow--down">
          {downChevronY.map((y) => <path d={`M144 ${y + 4} L152 ${y + 12} L160 ${y + 4}`} />)}
        </g>
        <!-- Upward: generating on top of the Record (Layer 2 → Layer 1) -->
        <g class="flow flow--up">
          {upChevronY.map((y) => <path d={`M300 ${y + 12} L308 ${y + 4} L316 ${y + 12}`} />)}
        </g>
      </svg>
    </div>

    <figcaption class="placeholder">
      [Figure: Evidence → (declarations, rules, computations) → Outputs, with Record (recording) and verifier (third-party verification) running through the layer beneath]
    </figcaption>
  </figure>

  <ol class="layers">
    {
      layers.map((layer) => (
        <li>
          <p class="layer-n">{layer.n}</p>
          <h3>{layer.title}</h3>
          <p>{layer.body}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  /* 図の列と本文の列が同じ 2 行を共有する。行 1 = Layer 1 (菱形と本文)、
     行 2 = Layer 2。各行の高さは菱形と本文の高いほうが決める */
  .interaction {
    display: grid;
    grid-template-columns: minmax(0, 18.5rem) minmax(0, 1fr);
    column-gap: 3rem;
    row-gap: 2rem;
  }

  .diagram {
    display: contents;
  }

  .slab-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .slab-svg--1 {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    position: relative;
    z-index: 1;
  }

  /* Layer 2 の枠。行 2 いっぱいに伸ばし、菱形はその上端に置く。
     cqw を子要素で使うためのコンテナでもある */
  .slab2 {
    grid-column: 1;
    grid-row: 2;
    position: relative;
    z-index: 1;
    container-type: inline-size;
  }

  .slab2 .slab-svg {
    position: relative;
    z-index: 2;
  }

  /* 矢印は菱形 1 の下端 (行 1 の上から 66.875cqw) と菱形 2 の上端
     (行 1 の下から行間 2rem ＋ 0.625cqw) の中間に置く。行 1 が本文で
     伸びても、この式が中間点を追いかける */
  .flows {
    position: absolute;
    left: 0;
    top: calc(50% + 1rem + 33.75cqw);
    width: 100%;
    height: 23.75cqw;
    transform: translateY(-50%);
    /* ベルトの出入口は端で溶けるように消す */
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 25%, #000 75%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 25%, #000 75%, transparent);
  }

  /* 点線の basis は行 1。下端は負のオフセットで行間を越え、菱形 2 の
     角・頂点にちょうど届く長さで止める */
  .links {
    grid-column: 1;
    grid-row: 1;
    position: relative;
    z-index: 0;
    container-type: inline-size;
  }

  /* 点線は 1px 幅の縦帯を繰り返しグラデーションで塗る。SVG の stroke と違い、
     高さが変わっても破線の刻みが伸びない */
  .link {
    position: absolute;
    width: 1px;
    background: repeating-linear-gradient(
      to bottom,
      var(--ink-4) 0 2px,
      transparent 2px 7px
    );
  }

  /* 3.125cqw = 菱形の左右の角の x 位置 (viewBox 内 80/320)。40cqw = 菱形 1 の
     角の y 位置、66.875cqw = 手前の頂点の y 位置。下端の 27.5cqw / 0.625cqw は
     菱形 2 の角・頂点の、行 2 上端からの深さ */
  .link--left {
    left: calc(3.125cqw - 0.5px);
    top: 40cqw;
    bottom: calc(-2rem - 27.5cqw);
  }

  .link--right {
    right: calc(3.125cqw - 0.5px);
    top: 40cqw;
    bottom: calc(-2rem - 27.5cqw);
  }

  .link--center {
    left: calc(50% - 0.5px);
    top: 66.875cqw;
    bottom: calc(-2rem - 0.625cqw);
  }

  /* 中心線の続き。菱形 2 の上面を前面から横切り、手前の頂点で
     稜線 (divider) に引き継ぐ */
  .link--face {
    left: calc(50% - 0.5px);
    top: 0.625cqw;
    height: 53.75cqw;
    z-index: 3;
  }

  /* 本文は各行の上端から始める。菱形の頂点も行の上端 (0.625cqw 下) にあるので、
     本文の開始位置と菱形の縦位置が揃う */
  .layers {
    display: contents;
    list-style: none;
  }

  .layers li {
    grid-column: 2;
    margin: 0;
    max-width: var(--measure);
    align-self: start;
  }

  .layers li:first-child {
    grid-row: 1;
  }

  .layers li:last-child {
    grid-row: 2;
  }

  .layer-n {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .layers h3 {
    font-size: 1.05rem;
    margin-bottom: 0.6rem;
  }

  .layers p:last-child {
    margin-bottom: 0;
    color: var(--ink-2);
  }

  figcaption {
    grid-column: 1 / -1;
    grid-row: 3;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    line-height: 1.6;
    text-align: center;
  }

  /* 面は薄いグレーの塗りだけ。奥の線はこの塗りで隠れる */
  .body {
    fill: var(--wash-lo);
  }

  .deck {
    fill: var(--wash-hi);
  }

  /* 外形の輪郭だけをはっきり引く */
  .outline {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.25;
    stroke-linejoin: round;
  }

  /* 内側の区切り (上面と側面の境目、手前の稜線) は控えめに */
  .divider {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .mark path,
  .mark circle,
  .mark rect,
  .mark line {
    fill: none;
    stroke: var(--ink-4);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .mark .mark-line {
    stroke-linecap: round;
  }

  .mark .mark-dot {
    fill: var(--ink-4);
    stroke: none;
  }

  /* 背後の線を面の色で抜き、紋の要素どうしに余白をつくる */
  .mark .mark-knockout circle,
  .mark .mark-knockout rect {
    fill: var(--wash-hi);
    stroke: var(--wash-hi);
    stroke-width: 4;
  }

  /* レンズは面の色で塗り、下を通る持ち手の根元を隠す */
  .mark .lens {
    fill: var(--wash-hi);
  }

  .flow path {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.7;
  }

  /* 1 周期 (矢印の間隔 30) ぶん平行移動してループする。列の余分な 1 つが
     窓の外から入ってくるので、継ぎ目なくベルトコンベア状に見える */
  .flow--down {
    animation: belt-down 2.4s linear infinite;
  }

  .flow--up {
    animation: belt-up 2.4s linear infinite;
  }

  @keyframes belt-down {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(30px);
    }
  }

  @keyframes belt-up {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-30px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow--down,
    .flow--up {
      animation: none;
    }
  }

