---
import type { TocItem } from '../consts';

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

<nav class="page-menu" aria-label="ページ内メニュー">
  <p class="eyebrow">On this page</p>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`} data-toc-link={item.id}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // 現在読んでいる見出しをページ内メニューで示す
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  const targets = Array.from(links)
    .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
    .filter((el): el is HTMLElement => el !== null);

  if (targets.length > 0) {
    const setActive = (id: string) => {
      links.forEach((link) => {
        link.toggleAttribute('data-active', link.dataset.tocLink === id);
      });
    };

    // 画面上部の帯を基準に、そこを最後に通過した節を現在地とする。
    // 直前の節がわずかに残っている状態でも、読んでいる節が選ばれる。
    const update = () => {
      const band = window.innerHeight * 0.3;

      // 描画されていない節 (display:none) は矩形が 0 になるため除外する
      const rendered = targets
        .map((target) => ({ target, rect: target.getBoundingClientRect() }))
        .filter(({ rect }) => rect.width > 0 || rect.height > 0);

      if (rendered.length === 0) return;

      let current = rendered[0]!.target;
      for (const { target, rect } of rendered) {
        if (rect.top <= band) {
          current = target;
        }
      }
      setActive(current.id);
    };

    // 交差の変化を更新の合図として使う (スクロールごとの計算を避ける)
    const observer = new IntersectionObserver(update, {
      rootMargin: '0px 0px -70% 0px',
      threshold: 0,
    });

    targets.forEach((target) => observer.observe(target));
  }
</script>

<style>
  /* スクロールに追従して常時表示。ヘッダーの高さぶん下げる */
  .page-menu {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    max-height: calc(100vh - var(--header-h) - 4rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .eyebrow {
    margin: 0 0 0.9rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--rule-faint);
  }

  li {
    margin: 0;
  }

  a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.9rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    font-size: 0.84rem;
    line-height: 1.45;
    text-decoration: none;
    color: var(--ink-3);
  }

  a:hover {
    color: var(--ink);
  }

  a[data-active] {
    color: var(--ink);
    border-left-color: var(--ink);
  }

  @media (max-width: 1000px) {
    .page-menu {
      position: static;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--rule-faint);
    }
  }
</style>
