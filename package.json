{
  "name": "corp-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Astro corporate site",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/content-impact.mjs && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "content:impact": "node scripts/content-impact.mjs",
    "test:content-impact": "node --test scripts/content-impact.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
